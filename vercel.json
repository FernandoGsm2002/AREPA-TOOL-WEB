{
  "version": 2,
  "name": "arepa-tool-admin",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/register.html",
      "destination": "/register",
      "permanent": true
    },
    {
      "source": "/forgot-password.html",
      "destination": "/recover",
      "permanent": true
    },
    {
      "source": "/reset-password.html",
      "destination": "/recover",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "bypass.arepatool.com" }],
      "destination": "/a12plus.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/supabase/(.*)",
      "destination": "https://lumhpjfndlqhexnjmvtu.supabase.co/$1"
    },
    {
      "source": "/panel-a7f3k9x2",
      "destination": "/hide.html"
    },
    {
      "source": "/auth/files",
      "destination": "/files.html"
    },
    { "source": "/auth/tools", "destination": "/tools.html" },
    { "source": "/a12plus", "destination": "/a12plus.html" },
    { "source": "/a12plus/(.*)", "destination": "/a12plus.html" }
  ],
  "headers": [
    {
      "source": "/(loginreseller|panelreseller)(/|\\.html)?",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/kg/(.*).apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"ArepaKnoxGuard-test.apk\"" }
      ]
    },
    {
      "source": "/kg2/(.*).apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"ArepaKnoxGuard2-test.apk\"" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://arepatool.com"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
