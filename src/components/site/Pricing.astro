---
import { ArrowRight, CheckCircle2, ShieldCheck, Store, Zap } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";

const perks = [
  "Licencia valida por 12 meses",
  "Generacion ilimitada de DNS",
  "Actualizaciones constantes",
  "Cambio de PC cada 3 horas",
  "Grupo Oficial de soporte y dudas",
];
---

<section id="pricing" class="section-plain">
  <div class="site-container pricing-layout">
    <div class="section-heading">
      <h2>Activa tu estación de trabajo.</h2>
      <p>La licencia se gestiona con un distribuidor oficial verificado. Consulta disponibilidad y elige el plan que mejor encaje con tu taller.</p>
    </div>

  <div class="pricing-card relative overflow-hidden p-5 sm:p-8">
    <span class="bg-primary text-primary-foreground relative inline-flex items-center gap-1.5 px-3 py-1.5 text-[10px] font-extrabold tracking-[0.1em] uppercase">
      <Zap className="size-3.5 fill-current" />
      Licencia anual
    </span>

    <div class="relative mt-6 grid items-center gap-6 sm:grid-cols-[160px_1fr] sm:gap-8">
      <div class="border-primary/20 bg-background/40 flex h-32 items-center justify-center overflow-hidden border shadow-inner shadow-black/20">
        <img src="/pngs/arepalanding.png" alt="Licencia ArepaTool" class="-my-12 h-56 w-full object-contain" />
      </div>
      <div class="text-left">
        <div class="flex items-center gap-2">
          <ShieldCheck className="text-primary size-5" />
          <h3 class="font-display text-xl font-bold tracking-[-0.03em] sm:text-2xl">Licencia Activation</h3>
        </div>
        <p class="text-muted-foreground mt-2 text-sm leading-6">Activa ArepaTool con un distribuidor oficial verificado.</p>
        <p class="font-display text-primary mt-4 text-3xl font-bold tracking-[-0.04em]">Consultar Precio</p>
      </div>
    </div>

    <div class="border-border/60 relative my-7 border-t"></div>

    <ul class="relative grid gap-x-7 gap-y-3 sm:grid-cols-2">
      {
        perks.map((perk) => (
          <li class="flex items-start gap-2.5 text-sm leading-5">
            <span class="bg-primary/12 text-primary mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full">
              <CheckCircle2 className="size-3.5" />
            </span>
            <span>{perk}</span>
          </li>
        ))
      }
    </ul>

    <a href="#resellers" class={buttonVariants({ size: "lg", className: "relative mt-8 w-full shadow-xl shadow-primary/20 transition-transform hover:-translate-y-0.5" })}>
      <Store className="size-4" />
      Ver distribuidores y resellers
      <ArrowRight className="ml-auto size-4" />
    </a>
  </div>
  </div>
</section>
