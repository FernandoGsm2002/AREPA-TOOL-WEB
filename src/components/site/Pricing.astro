---
const plans = [
  {
    eyebrow: "ArepaTool Rent",
    name: "Tool Rental",
    duration: "12 hours",
    price: "4",
    description: "PayPal, crypto or reseller activation.",
    featured: false,
    accent: true,
  },
  {
    eyebrow: "ArepaTool Pro",
    name: "Professional",
    duration: "3 months",
    price: "12",
    description: "Professional access for your workshop.",
    featured: false,
    accent: false,
  },
  {
    eyebrow: "ArepaTool Pro",
    name: "Professional",
    duration: "6 months",
    price: "19",
    description: "The balanced plan for active unlockers.",
    featured: true,
    accent: false,
  },
  {
    eyebrow: "ArepaTool Pro",
    name: "Professional",
    duration: "1 year",
    price: "26",
    description: "Full-year access for your daily work.",
    featured: false,
    accent: false,
  },
];
---

<section id="pricing" class="pricing-section">
  <div class="site-container">
    <div class="pricing-heading">
      <p class="pricing-kicker">ArepaTool licensing</p>
      <h2>Choose your plan</h2>
      <p>Our updates are always free. Access every release with an active ArepaTool license.</p>
    </div>

    <div class="pricing-grid">
      {plans.map((plan) => (
        <article class:list={[
          "pricing-plan",
          plan.accent && "pricing-plan--accent",
          plan.featured && "pricing-plan--featured",
        ]}>
          {plan.featured && <span class="pricing-plan__badge">Popular</span>}
          <p class="pricing-plan__eyebrow">{plan.eyebrow}</p>
          <h3>{plan.name}</h3>
          <p class="pricing-plan__duration">{plan.duration}</p>
          <div class="pricing-plan__price">
            <span>Price /</span>
            <strong>${plan.price}</strong>
          </div>
          <p class="pricing-plan__description">{plan.description}</p>
          <div class="pricing-plan__actions">
            <a class="pricing-button pricing-button--primary" href="/resellers">Buy Now</a>
            <a class="pricing-button pricing-button--secondary" href="/resellers">Buy From Resellers</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing-section {
    border-bottom: 1px solid rgb(23 34 45 / 12%);
    background: #f1f0ea;
    padding-block: 5rem 6rem;
  }

  .pricing-heading {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }

  .pricing-kicker,
  .pricing-plan__eyebrow {
    color: #a27a23;
    font-family: var(--font-mono);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .pricing-heading h2 {
    margin-top: .55rem;
    color: #17222d;
    font-family: 'Avenir Next', 'Segoe UI', sans-serif;
    font-size: clamp(2.35rem, 5vw, 3.8rem);
    letter-spacing: -.065em;
    line-height: .98;
  }

  .pricing-heading > p:last-child {
    margin-top: 1.05rem;
    color: #68747d;
    font-size: 1rem;
    line-height: 1.6;
  }

  .pricing-grid {
    display: grid;
    gap: 1rem;
    margin-top: 3.25rem;
  }

  .pricing-plan {
    position: relative;
    display: flex;
    min-height: 22rem;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1.25rem 1.25rem;
    border: 1px solid #d4d6d3;
    border-radius: .95rem;
    background: #faf9f4;
    color: #17222d;
    text-align: center;
  }

  .pricing-plan--accent {
    border-color: #e98a24;
    background: #fff0dc;
    color: #5a3518;
  }

  .pricing-plan--accent .pricing-plan__eyebrow,
  .pricing-plan--accent .pricing-plan__duration,
  .pricing-plan--accent .pricing-plan__description { color: #795a3f; }

  .pricing-plan--featured {
    border: 2px solid #e0a916;
    box-shadow: 0 18px 40px rgb(216 155 36 / 15%);
  }

  .pricing-plan__badge {
    position: absolute;
    top: -.8rem;
    padding: .4rem .85rem;
    border-radius: 999px;
    background: #eab51b;
    color: #4b370b;
    font-family: var(--font-mono);
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .pricing-plan h3 {
    margin-top: .75rem;
    color: inherit;
    font-family: 'Avenir Next', 'Segoe UI', sans-serif;
    font-size: 1.25rem;
    letter-spacing: -.035em;
  }

  .pricing-plan__duration {
    margin-top: .3rem;
    color: #77828a;
    font-size: .88rem;
  }

  .pricing-plan__price {
    display: flex;
    align-items: baseline;
    gap: .35rem;
    margin-top: 1.3rem;
  }

  .pricing-plan__price span {
    color: #85909a;
    font-size: .72rem;
  }

  .pricing-plan--accent .pricing-plan__price span { color: #795a3f; }

  .pricing-plan__price strong {
    color: inherit;
    font-family: 'Avenir Next', 'Segoe UI', sans-serif;
    font-size: 2.55rem;
    font-weight: 500;
    letter-spacing: -.065em;
    line-height: 1;
  }

  .pricing-plan__description {
    max-width: 15rem;
    min-height: 2.7rem;
    margin-top: .85rem;
    color: #71808a;
    font-size: .78rem;
    line-height: 1.5;
  }

  .pricing-plan__actions {
    display: grid;
    width: 100%;
    gap: .5rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .pricing-button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: .75rem;
    font-size: .78rem;
    font-weight: 700;
    transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
  }

  .pricing-button:hover { transform: translateY(-2px); }

  .pricing-button--primary {
    background: #e98a24;
    color: #3e2206;
    box-shadow: 0 8px 18px rgb(216 155 36 / 18%);
  }

  .pricing-button--primary:hover { background: #d97916; }

  .pricing-button--secondary {
    border: 1px solid #c6d1df;
    background: transparent;
    color: #53616d;
  }

  .pricing-plan--accent .pricing-button--secondary {
    border-color: #dfa96f;
    color: #8e4d14;
  }

  @media (min-width: 760px) {
    .pricing-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1100px) {
    .pricing-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
