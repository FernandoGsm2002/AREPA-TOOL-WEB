---
import { ArrowRight, CalendarDays, Check, Coins, KeyRound } from 'lucide-react';
import { getLocaleCopy, localeFromPath, localizedPath, withoutLocale, type Locale } from '@/lib/i18n';
import { marketingCopy } from '@/lib/marketing-copy';
interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const plans = getLocaleCopy(locale).pricing.plans;
const copy = marketingCopy[locale];
const [credit, ...licenses] = plans;
const Heading = withoutLocale(Astro.url.pathname) === "/pricing" ? "h1" : "h2";
---
<section id="pricing" class="license-section" aria-labelledby="license-title">
  <div class="site-container">
    <div class="marketing-heading marketing-heading--center">
      <Heading id="license-title">{copy.pricingTitle}</Heading>
      <p>{copy.pricingIntro}</p>
    </div>
    <div class="license-grid">
      {licenses.map((plan, index) => <article class:list={['license-plan', index === 2 && 'license-plan--annual']}>
        <div class="license-plan__top"><CalendarDays size={22} />{index === 2 && <span>{copy.annual}</span>}</div>
        <h3>{plan.duration}</h3><p class="license-plan__description">{plan.description}</p>
        <ul>{copy.included.map(item => <li><Check size={16} />{item}</li>)}</ul>
        <div class="license-plan__price"><strong>{plan.price}</strong><span>USDT</span></div>
        <a class="marketing-button" href={localizedPath(locale, '/resellers')}>{copy.buyPlan}<ArrowRight size={18} /></a>
        <p class="license-plan__activation"><KeyRound size={13} />{copy.activation}</p>
      </article>)}
    </div>
    <div class="service-credits">
      <Coins size={30} aria-hidden="true" />
      <div><h3>{copy.creditTitle}</h3><p>{copy.creditNote}</p></div>
      <div class="service-credits__price"><strong>{credit.price} <small>USDT</small></strong><span>{credit.duration}</span></div>
      <a class="marketing-button marketing-button--secondary" href={localizedPath(locale, '/resellers')}>{copy.buyCredits}<ArrowRight size={16} /></a>
    </div>
    <p class="license-section__signup">{copy.newAccount} <a href="/register">{copy.createAccount}<ArrowRight size={14} /></a></p>
  </div>
</section>
