---
import { UserPlus, LogIn, ChevronDown } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import MobileNav from "./MobileNav";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getLocaleCopy, getNavLinks, localeFromPath, localizedPath, withoutLocale, type Locale } from "@/lib/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const currentPath = withoutLocale(Astro.url.pathname);
const copy = getLocaleCopy(locale);
const allLinks = getNavLinks(locale);
const navLinks = ['/', '/supportedmodels', '/pricing', '/resellers'].map(path => allLinks.find(link => link.href === path)!);
const resourceLinks = allLinks.filter(link => !navLinks.includes(link));
const resourceLabel = locale === 'es' ? 'Recursos' : locale === 'pt-br' ? 'Recursos' : 'Resources';
---

<header class="site-header">
  <div class="site-container site-nav-inner">
    <a href={localizedPath(locale, "/")} class="site-brand">
      <span class="site-brand-logo" aria-hidden="true">
        <img src="/pngs/arepatool-logo-mark.webp" alt="" />
      </span>
      <span class="site-brand-copy">
        <strong>ArepaTool</strong>
        <span>Mobile service tools</span>
      </span>
    </a>

    <nav class="site-nav-links" aria-label={copy.nav.home === "Inicio" ? "Navegación principal" : "Primary navigation"}>
      {
        navLinks.map((link) => (
          <a
            href={localizedPath(locale, link.href)}
            class:list={[
              currentPath === link.href && "text-foreground",
            ]}
            aria-current={currentPath === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <details class="nav-resources">
        <summary>{resourceLabel}<ChevronDown size={14} /></summary>
        <div>{resourceLinks.map(link => <a href={localizedPath(locale, link.href)} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>)}</div>
      </details>
    </nav>

    <div class="site-nav-actions">
      <LanguageSwitcher locale={locale} />
      <a
        href="/login"
        class={`site-nav-login ${buttonVariants({ size: "sm", variant: "outline" })}`}
        data-slot="button"
        data-variant="outline"
        data-size="sm"
      >
        <LogIn className="size-4" />
        {copy.nav.login}
      </a>
      <a href="/register" class={`site-nav-register ${buttonVariants({ size: "sm", className: "shadow-lg shadow-primary/20" })}`} data-slot="button" data-variant="default" data-size="sm">
        <UserPlus className="size-4" />
        {copy.nav.register}
      </a>
    </div>

    <MobileNav client:load locale={locale} />
  </div>
</header>

<script>
  const resourceMenu = document.querySelector<HTMLDetailsElement>('.nav-resources');
  document.addEventListener('click', (event) => {
    if (resourceMenu && event.target instanceof Node && !resourceMenu.contains(event.target)) resourceMenu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && resourceMenu?.open) {
      resourceMenu.open = false;
      resourceMenu.querySelector('summary')?.focus();
    }
  });
</script>
