---
import { UserPlus, LogIn } from "lucide-react";
import { Button, buttonVariants } from "@/components/ui/button";
import { WhatsAppIcon } from "@/components/icons/BrandIcons";
import MobileNav from "./MobileNav";
import { navLinks } from "@/lib/site-data";

const currentPath = Astro.url.pathname;
---

<header class="border-border/70 bg-background/80 sticky top-0 z-50 border-b backdrop-blur-xl">
  <div class="mx-auto flex h-22 max-w-7xl items-center justify-between gap-5 px-4 sm:px-6">
    <a href="/" class="group flex h-17 w-48 shrink-0 items-center overflow-hidden rounded-2xl border border-white/8 bg-linear-to-br from-white/[0.07] to-transparent px-2.5 shadow-lg shadow-black/10 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-primary/10">
      <img src="/pngs/arepalanding.png" alt="ArepaTool" class="-my-8 h-36 w-full object-contain transition-transform duration-300 group-hover:scale-[1.04]" />
    </a>

    <nav class="border-border/60 bg-muted/35 hidden items-center gap-1 rounded-full border p-1 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-full px-3.5 py-2 text-sm font-medium transition-all duration-200",
              currentPath === link.href
                ? "bg-primary text-primary-foreground shadow-md shadow-primary/25"
                : "text-muted-foreground hover:bg-background hover:text-foreground",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <Button
        data-open-wa
        className="bg-[#25D366] text-white shadow-lg shadow-[#25D366]/15 hover:bg-[#1ea952]"
        size="sm"
      >
        <WhatsAppIcon className="size-4" />
        Grupo WhatsApp
      </Button>
      <a
        href="/login"
        class={buttonVariants({ size: "sm", variant: "outline" })}
        data-slot="button"
        data-variant="outline"
        data-size="sm"
      >
        <LogIn className="size-4" />
        Iniciar sesión
      </a>
      <a href="/register" class={buttonVariants({ size: "sm", className: "shadow-lg shadow-primary/20" })} data-slot="button" data-variant="default" data-size="sm">
        <UserPlus className="size-4" />
        Registro
      </a>
    </div>

    <MobileNav client:load />
  </div>
</header>
