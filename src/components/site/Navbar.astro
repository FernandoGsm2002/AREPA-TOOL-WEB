---
import { UserPlus, LogIn } from "lucide-react";
import { Button, buttonVariants } from "@/components/ui/button";
import { WhatsAppIcon } from "@/components/icons/BrandIcons";
import MobileNav from "./MobileNav";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getLocaleCopy, getNavLinks, localeFromPath, localizedPath, withoutLocale, type Locale } from "@/lib/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const currentPath = withoutLocale(Astro.url.pathname);
const copy = getLocaleCopy(locale);
const navLinks = getNavLinks(locale);
---

<header class="site-header">
  <div class="site-container site-nav-inner">
    <a href={localizedPath(locale, "/")} class="site-brand">
      <span class="site-brand-logo" aria-hidden="true">
        <img src="/pngs/arepatool-logo-mark.png" alt="" />
      </span>
      <span class="site-brand-copy">
        <strong>ArepaTool</strong>
        <span>MDM Tool</span>
      </span>
    </a>

    <nav class="site-nav-links" aria-label="Navegación principal">
      {
        navLinks.map((link) => (
          <a
            href={localizedPath(locale, link.href)}
            class:list={[
              currentPath === link.href && "text-foreground",
            ]}
            aria-current={currentPath === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="site-nav-actions">
      <LanguageSwitcher locale={locale} />
      <Button
        data-open-wa
        className="site-nav-whatsapp bg-[#25D366] text-white shadow-lg shadow-[#25D366]/15 hover:bg-[#1ea952]"
        size="sm"
      >
        <WhatsAppIcon className="size-4" />
        {copy.nav.whatsapp}
      </Button>
      <a
        href="/login"
        class={`site-nav-login ${buttonVariants({ size: "sm", variant: "outline" })}`}
        data-slot="button"
        data-variant="outline"
        data-size="sm"
      >
        <LogIn className="size-4" />
        {copy.nav.login}
      </a>
      <a href="/register" class={`site-nav-register ${buttonVariants({ size: "sm", className: "shadow-lg shadow-primary/20" })}`} data-slot="button" data-variant="default" data-size="sm">
        <UserPlus className="size-4" />
        {copy.nav.register}
      </a>
    </div>

    <MobileNav client:load locale={locale} />
  </div>
</header>
