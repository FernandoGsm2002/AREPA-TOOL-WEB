---
import { X } from "lucide-react";
---

<div
  id="announcement-banner"
  class="border-primary/35 from-primary/14 via-card to-card flex items-center justify-center gap-3 border-y bg-linear-to-r px-4 py-2 text-center text-sm text-foreground sm:px-5"
>
  <img src="/pngs/arepatool-v2.2.2-update.png" alt="ArepaTool v2.2.2" class="size-12 shrink-0 rounded-md border border-primary/30 object-cover object-top shadow-md shadow-primary/15 sm:size-14" loading="eager" decoding="async" />
  <strong class="font-display tracking-tight">🚀 ArepaTool v2.2.2 ya está disponible</strong>
  <button
    id="announcement-close"
    class="text-muted-foreground hover:text-foreground ml-1 rounded-md p-1 leading-none transition-colors hover:bg-white/8"
    title="Cerrar"
    aria-label="Cerrar"
  >
    <X className="size-4" />
  </button>
</div>

<script>
  document.getElementById("announcement-close")?.addEventListener("click", () => {
    document.getElementById("announcement-banner")?.remove();
  });
</script>
