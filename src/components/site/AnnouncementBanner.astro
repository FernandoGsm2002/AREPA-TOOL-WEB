---
import { ArrowRight, Flame, LogIn, Server, Tag } from "lucide-react";
import { getLocaleCopy, localeFromPath, type Locale } from "@/lib/i18n";

interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = getLocaleCopy(locale);
const labels = locale === "es"
  ? { checking: "Consultando…", online: "Servidor activo", offline: "Servidor offline", unavailable: "Estado no disponible", price: "Precio", credits: "créditos" }
  : locale === "pt-br"
    ? { checking: "Consultando…", online: "Servidor ativo", offline: "Servidor offline", unavailable: "Status indisponível", price: "Preço", credits: "créditos" }
    : { checking: "Checking…", online: "Server online", offline: "Server offline", unavailable: "Status unavailable", price: "Price", credits: "credits" };
---

<aside class="xiaomi-announcement" aria-label={copy.announcement.aria} data-xiaomi-announcement>
  <div class="xiaomi-announcement__inner">
    <div class="xiaomi-announcement__main">
      <span class="xiaomi-announcement__icon" aria-hidden="true"><Flame className="size-4" /></span>
      <span class="xiaomi-announcement__burst" aria-label={copy.announcement.label}><span>{copy.announcement.label}</span></span>
      <div class="xiaomi-announcement__copy">
        <p><strong>{copy.announcement.text}</strong></p>
        <p class="xiaomi-announcement__subline">{copy.announcement.brands}</p>
      </div>
    </div>
    <div class="xiaomi-announcement__facts" aria-live="polite">
      <span class="xiaomi-announcement__fact" data-xiaomi-status><Server className="size-3.5" aria-hidden="true" /><span>{labels.checking}</span></span>
      <span class="xiaomi-announcement__fact" data-xiaomi-price><Tag className="size-3.5" aria-hidden="true" /><span>{labels.price}: —</span></span>
    </div>
    <a class="xiaomi-announcement__action" href="/login"><LogIn className="size-3.5" />{copy.announcement.action}<ArrowRight className="size-3.5" /></a>
  </div>
</aside>

<script define:vars={{ labels }}>
  const banner = document.querySelector("[data-xiaomi-announcement]");
  const statusNode = banner?.querySelector("[data-xiaomi-status]");
  const priceNode = banner?.querySelector("[data-xiaomi-price]");

  function setStatus(text, state) {
    if (!statusNode) return;
    statusNode.dataset.state = state;
    const label = statusNode.querySelector("span:last-child");
    if (label) label.textContent = text;
  }

  const controller = new AbortController();
  const timeout = window.setTimeout(() => controller.abort(), 7000);

  fetch("https://api2.arepatool.com/api/xiaomi-auth/public-status", {
    headers: { Accept: "application/json" },
    cache: "no-store",
    signal: controller.signal,
  })
    .then((response) => response.ok ? response.json() : Promise.reject(new Error("status_unavailable")))
    .then((data) => {
      const active = data.active === true;
      setStatus(active ? labels.online : labels.offline, active ? "online" : "offline");
      if (priceNode && Number.isFinite(Number(data.creditCost)) && Number(data.creditCost) > 0) {
        const label = priceNode.querySelector("span:last-child");
        if (label) label.textContent = `${labels.price}: ${Number(data.creditCost).toLocaleString(undefined, { maximumFractionDigits: 2 })} ${labels.credits}`;
      }
    })
    .catch(() => setStatus(labels.unavailable, "unknown"))
    .finally(() => window.clearTimeout(timeout));
</script>

<style>
  .xiaomi-announcement { border-bottom: 1px solid rgb(162 122 35 / 24%); background: #fff7df; color: #4a3720; }
  .xiaomi-announcement__inner { display: flex; max-width: 80rem; align-items: center; gap: .75rem 1.15rem; margin-inline: auto; padding: .7rem 1rem; }
  .xiaomi-announcement__main { display: flex; min-width: 0; align-items: center; gap: .65rem; }
  .xiaomi-announcement__icon { display: inline-flex; width: 1.8rem; height: 1.8rem; flex: 0 0 auto; align-items: center; justify-content: center; border: 1px solid rgb(162 122 35 / 30%); border-radius: 999px; background: rgb(234 179 8 / 14%); color: #a27a23; }
  .xiaomi-announcement__burst { display: inline-grid; width: 3.1rem; height: 3.1rem; flex: 0 0 auto; place-items: center; background: #a91212; color: #fff9ed; clip-path: polygon(50% 0%, 61% 14%, 76% 5%, 79% 22%, 97% 18%, 89% 35%, 100% 50%, 84% 60%, 94% 77%, 76% 75%, 75% 96%, 59% 85%, 47% 100%, 37% 85%, 20% 94%, 22% 75%, 3% 78%, 13% 61%, 0% 49%, 14% 38%, 5% 21%, 23% 24%, 24% 5%, 39% 15%); font-family: var(--font-display); font-size: .47rem; font-weight: 900; letter-spacing: .04em; line-height: 1; text-align: center; transform: rotate(-8deg); }
  .xiaomi-announcement__burst span { display: block; max-width: 2.2rem; transform: rotate(8deg); }
  .xiaomi-announcement__copy { min-width: 0; }
  .xiaomi-announcement__copy p { margin: 0; }
  .xiaomi-announcement__copy p:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .xiaomi-announcement__subline { margin-top: .12rem !important; color: #795b32; font-size: .7rem; }
  .xiaomi-announcement__facts { display: flex; flex: 0 0 auto; flex-wrap: wrap; gap: .4rem; }
  .xiaomi-announcement__fact { display: inline-flex; align-items: center; gap: .35rem; border: 1px solid rgb(162 122 35 / 24%); border-radius: 999px; padding: .28rem .55rem; color: #795b32; font-family: var(--font-mono); font-size: .64rem; white-space: nowrap; }
  .xiaomi-announcement__fact[data-state="online"] { border-color: rgb(47 123 90 / 30%); color: #2f7b5a; }
  .xiaomi-announcement__fact[data-state="offline"], .xiaomi-announcement__fact[data-state="unknown"] { border-color: rgb(168 78 13 / 26%); color: #a84e0d; }
  .xiaomi-announcement__action { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .35rem; margin-left: auto; color: #805816; font-size: .72rem; font-weight: 700; text-decoration: underline; text-decoration-color: rgb(128 88 22 / 35%); text-underline-offset: .22rem; }
  .xiaomi-announcement__action:hover { color: #2b2116; }
  @media (max-width: 900px) { .xiaomi-announcement__inner { flex-wrap: wrap; justify-content: center; text-align: center; } .xiaomi-announcement__main { justify-content: center; } .xiaomi-announcement__facts { justify-content: center; } .xiaomi-announcement__action { margin-left: 0; } }
  @media (max-width: 520px) { .xiaomi-announcement__inner { align-items: stretch; } .xiaomi-announcement__main, .xiaomi-announcement__facts, .xiaomi-announcement__action { width: 100%; } .xiaomi-announcement__main, .xiaomi-announcement__facts, .xiaomi-announcement__action { justify-content: center; } .xiaomi-announcement__copy p:first-child { white-space: normal; } .xiaomi-announcement__burst { width: 2.8rem; height: 2.8rem; } }
</style>
