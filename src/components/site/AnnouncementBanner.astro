---
import { ArrowRight, Clock3, LogIn, Server, Tag } from "lucide-react";
import { getLocaleCopy, localeFromPath, type Locale } from "@/lib/i18n";

interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = getLocaleCopy(locale);
const labels = locale === "es"
  ? { checking: "Consultando…", online: "Servidor activo", offline: "Servidor offline", unavailable: "Estado no disponible", price: "Precio", credits: "créditos", cooldown: "Cooldown", estimate: "1 crédito = 1.5 USDT · según tu reseller" }
  : locale === "pt-br"
    ? { checking: "Consultando…", online: "Servidor ativo", offline: "Servidor offline", unavailable: "Status indisponível", price: "Preço", credits: "créditos", cooldown: "Cooldown", estimate: "1 crédito = 1.5 USDT · conforme seu revendedor" }
    : { checking: "Checking…", online: "Server online", offline: "Server offline", unavailable: "Status unavailable", price: "Price", credits: "credits", cooldown: "Cooldown", estimate: "1 credit = 1.5 USDT · depending on your reseller" };
---

<aside class="xiaomi-announcement" aria-label={copy.announcement.aria} data-xiaomi-announcement>
  <div class="xiaomi-announcement__inner">
    <div class="xiaomi-announcement__main">
      <img class="xiaomi-announcement__art" src="/pngs/xiaomi-arepa-christmas.webp" alt="" width="144" height="144" />
      <div class="xiaomi-announcement__copy">
        <p><strong>{copy.announcement.text}</strong></p>
        <p class="xiaomi-announcement__subline">{copy.announcement.brands}</p>
      </div>
    </div>
    <div class="xiaomi-announcement__details">
    <div class="xiaomi-announcement__facts">
      <span class="xiaomi-announcement__fact" data-xiaomi-status role="status"><Server className="size-5" aria-hidden="true" /><span>{labels.checking}</span></span>
      <span class="xiaomi-announcement__fact" data-xiaomi-price><Tag className="size-5" aria-hidden="true" /><span>{labels.price}: —</span></span>
      <span class="xiaomi-announcement__fact" data-xiaomi-cooldown><Clock3 className="size-5" aria-hidden="true" /><span>{labels.cooldown}: —</span></span>
    </div>
    <p class="xiaomi-announcement__estimate">{labels.estimate}</p>
    </div>
    <a class="xiaomi-announcement__action" href="/login"><LogIn className="size-3.5" />{copy.announcement.action}<ArrowRight className="size-3.5" /></a>
  </div>
</aside>

<script define:vars={{ labels }}>
  const banner = document.querySelector("[data-xiaomi-announcement]");
  const statusNode = banner?.querySelector("[data-xiaomi-status]");
  const priceNode = banner?.querySelector("[data-xiaomi-price]");
  const cooldownNode = banner?.querySelector("[data-xiaomi-cooldown]");
  let cooldownDeadline = null;

  function setStatus(text, state) {
    if (!statusNode) return;
    statusNode.dataset.state = state;
    const label = statusNode.querySelector("span:last-child");
    if (label) label.textContent = text;
  }

  function renderCooldown() {
    if (!cooldownNode || cooldownDeadline === null) return;
    const label = cooldownNode.querySelector("span:last-child");
    if (!label) return;
    const now = performance.now();
    while (cooldownDeadline <= now) cooldownDeadline += 24 * 60 * 60 * 1000;
    const total = Math.ceil((cooldownDeadline - now) / 1000);
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor((total % 3600) / 60);
    const seconds = total % 60;
    label.textContent = `${labels.cooldown}: ${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
  }

  const controller = new AbortController();
  const timeout = window.setTimeout(() => controller.abort(), 7000);

  fetch("https://api2.arepatool.com/api/xiaomi-auth/public-status", {
    headers: { Accept: "application/json" },
    cache: "no-store",
    signal: controller.signal,
  })
    .then((response) => response.ok ? response.json() : Promise.reject(new Error("status_unavailable")))
    .then((data) => {
      const active = data.active === true;
      setStatus(active ? labels.online : labels.offline, active ? "online" : "offline");
      if (priceNode && Number.isFinite(Number(data.creditCost)) && Number(data.creditCost) > 0) {
        const label = priceNode.querySelector("span:last-child");
        if (label) label.textContent = `${labels.price}: ${Number(data.creditCost).toLocaleString(undefined, { maximumFractionDigits: 2 })} ${labels.credits}`;
      }
      if (data.cooldownSeconds !== null && data.cooldownSeconds !== undefined &&
          Number.isFinite(Number(data.cooldownSeconds))) {
        cooldownDeadline = performance.now() + Math.max(0, Math.floor(Number(data.cooldownSeconds))) * 1000;
        renderCooldown();
        window.setInterval(renderCooldown, 1000);
      }
    })
    .catch(() => setStatus(labels.unavailable, "unknown"))
    .finally(() => window.clearTimeout(timeout));
</script>

<style>
  .xiaomi-announcement { border-bottom: 1px solid rgb(255 125 40 / 30%); background: linear-gradient(110deg, #21140d, #0d2017 65%, #111b21); color: #fff5e9; }
  .xiaomi-announcement__inner { display: flex; max-width: 86rem; min-height: 11rem; align-items: center; flex-wrap: wrap; gap: 1.25rem 2rem; margin-inline: auto; padding: 1rem 1.5rem; }
  .xiaomi-announcement__main { display: flex; min-width: 0; align-items: center; gap: 1rem; flex: 1 1 24rem; }
  .xiaomi-announcement__art { display: block; width: 9rem; height: 9rem; flex: 0 0 auto; object-fit: contain; }
  .xiaomi-announcement__copy { min-width: 0; }
  .xiaomi-announcement__copy p { margin: 0; }
  .xiaomi-announcement__copy strong { display: block; max-width: 23rem; font-family: var(--font-display); font-size: clamp(1.4rem, 2.3vw, 2rem); font-weight: 900; letter-spacing: -.035em; line-height: 1.12; }
  .xiaomi-announcement__subline { margin-top: .55rem !important; color: #ebb481; font-size: .9rem; font-weight: 600; }
  .xiaomi-announcement__details { flex: 1 1 34rem; }
  .xiaomi-announcement__facts { display: flex; flex-wrap: wrap; gap: .65rem; }
  .xiaomi-announcement__fact { display: inline-flex; align-items: center; gap: .6rem; border: 1px solid rgb(255 176 84 / 35%); border-radius: .75rem; background: rgb(255 176 84 / 7%); padding: .9rem 1rem; color: #ffe0b7; font-size: clamp(.95rem, 1.3vw, 1.15rem); font-weight: 800; font-variant-numeric: tabular-nums; }
  .xiaomi-announcement__fact svg { flex-shrink: 0; }
  .xiaomi-announcement__fact[data-state="online"] { border-color: rgb(79 211 135 / 55%); background: rgb(40 140 80 / 16%); color: #9affbe; }
  .xiaomi-announcement__fact[data-state="offline"], .xiaomi-announcement__fact[data-state="unknown"] { border-color: rgb(255 149 79 / 50%); color: #ffb268; }
  .xiaomi-announcement__estimate { margin-top: .7rem; color: #d4dcd4; font-size: .9rem; line-height: 1.5; }
  .xiaomi-announcement__action { display: inline-flex; align-items: center; gap: .4rem; color: #ffc267; font-size: .85rem; font-weight: 700; text-decoration: underline; text-underline-offset: .25rem; }
  .xiaomi-announcement__action:hover { color: #fff5e9; }
  @media (max-width: 600px) {
    .xiaomi-announcement__inner { padding: 1rem; gap: 1rem; }
    .xiaomi-announcement__art { width: 6rem; height: 6rem; }
    .xiaomi-announcement__main { flex-basis: 100%; gap: .7rem; }
    .xiaomi-announcement__details { min-width: 0; }
    .xiaomi-announcement__facts { display: grid; grid-template-columns: 1fr; }
    .xiaomi-announcement__fact { padding: .75rem 1rem; }
  }
</style>
