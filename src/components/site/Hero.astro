---
import { ArrowRight } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { WindowsIcon } from "@/components/icons/BrandIcons";
---

<section class="hero-section">
  <div class="site-container hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">Modern software</p>
      <h1>ArepaTool <span>Professional tool for you.</span></h1>
      <p>A modern tool designed for unlockers like you</p>
      <div class="hero-release" aria-label="Versión y plataforma">
        <strong>v2.2.4</strong>
        <span>Windows</span>
        <span>Licencia protegida</span>
      </div>

      <div class="hero-actions">
        <a href="/pricing" class={buttonVariants({ size: "lg", className: "shadow-lg shadow-primary/15" })}>
          Ver licencia
          <ArrowRight className="size-4" />
        </a>
        <button type="button" data-open-installer-access class={buttonVariants({ size: "lg", variant: "secondary" })}>
          <WindowsIcon className="size-4" />
          Descargar ArepaTool
        </button>
      </div>

      <div class="hero-proof" aria-label="Módulos principales">
        <span>FRP</span>
        <span>MDM</span>
        <span>iCloud</span>
        <span>DNS</span>
        <span>MTK</span>
      </div>
    </div>

    <div class="hero-visual">
      <img
        class="hero-mascot"
        src="/pngs/windowslog.png"
        alt="Mascota de ArepaTool trabajando en un equipo Windows"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
  <p class="site-container hero-tagline">Compatible with modern brands on the market</p>
</section>

<script>
  document.addEventListener("click", (event) => {
    if ((event.target as HTMLElement)?.closest("[data-open-installer-access]")) {
      window.dispatchEvent(new CustomEvent("open-installer-access"));
    }
  });
</script>
