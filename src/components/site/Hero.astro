---
import { ArrowRight } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { WindowsIcon } from "@/components/icons/BrandIcons";
---

<section class="relative isolate overflow-hidden">
  <div class="via-background to-background pointer-events-none absolute inset-0 -z-10 bg-linear-to-b from-[#061426]/70"></div>
  <div class="pointer-events-none absolute -top-32 -right-32 -z-10 size-112 rounded-full bg-primary/16 blur-3xl"></div>
  <div class="pointer-events-none absolute top-1/2 -left-52 -z-10 size-96 rounded-full bg-cyan-400/8 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 sm:py-18 md:grid-cols-[minmax(0,.82fr)_minmax(0,1.18fr)] md:items-center md:gap-14 md:py-26">
    <div class="relative z-10">
      <div class="text-primary mb-4 inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/8 px-3 py-1 text-[0.68rem] font-bold tracking-[0.16em] uppercase">
        <span class="size-1.5 rounded-full bg-primary shadow-[0_0_12px_var(--color-primary)]"></span>
        Windows · v2.2.3
      </div>
      <p class="text-primary text-sm font-semibold tracking-wide uppercase">Compra tu licencia hoy</p>
      <h1 class="font-display mt-2 text-5xl leading-[1.02] font-black tracking-tight sm:text-6xl">
        ArepaToolV2
        <span class="text-primary block">MDM Edition 🫓</span>
      </h1>
      <p class="text-muted-foreground mt-5 max-w-md text-base leading-relaxed sm:text-lg">
        Una estación de trabajo para operaciones Android, Apple y soporte remoto, con licencia y descargas protegidas.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#pricing" class={buttonVariants({ size: "lg", className: "shadow-xl shadow-primary/20" })}>
          Explorar Licencia
          <ArrowRight className="size-4" />
        </a>
        <button type="button" data-open-installer-access class={buttonVariants({ size: "lg", variant: "secondary" })}>
          <WindowsIcon className="size-4" />
          Descarga Ahora
        </button>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-3xl md:max-w-none">
      <div class="from-primary/30 via-sky-400/10 absolute -inset-5 rounded-[2rem] bg-linear-to-tr to-transparent blur-2xl"></div>
      <figure class="border-primary/32 bg-[#0a111a]/92 relative overflow-hidden rounded-[1.35rem] border p-1.5 shadow-2xl shadow-black/65 backdrop-blur-sm sm:p-2.5">
        <div class="border-white/12 overflow-hidden rounded-[1rem] border bg-[#080d13]">
          <img
            src="/pngs/landingdisplay.jpg"
            alt="Interfaz de ArepaTool v2.2.3 con módulos Samsung, Android, MediaTek, Apple y USB-Redirector"
            class="block aspect-[1.52/1] w-full object-cover object-top transition-transform duration-700 ease-out hover:scale-[1.015]"
            loading="eager"
            decoding="async"
          />
        </div>
        <figcaption class="flex items-center justify-between gap-3 px-1.5 pt-2.5 text-[0.66rem] font-semibold tracking-[0.13em] text-muted-foreground uppercase sm:px-2">
          <span>ArepaTool Desktop</span>
          <span class="text-primary">Operaciones en un solo lugar</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  document.addEventListener("click", (event) => {
    if ((event.target as HTMLElement)?.closest("[data-open-installer-access]")) {
      window.dispatchEvent(new CustomEvent("open-installer-access"));
    }
  });
</script>
