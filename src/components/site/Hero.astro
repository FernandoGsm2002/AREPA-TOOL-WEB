---
import { ArrowRight } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { WindowsIcon } from "@/components/icons/BrandIcons";
---

<section class="hero-section">
  <div class="site-container hero-grid">
    <div class="hero-copy">
      <h1>Todo lo que tu taller necesita para <span>desbloquear y reparar.</span></h1>
      <p>ArepaTool reúne módulos Android, Apple, MDM, DNS y soporte remoto en una sola estación de trabajo para técnicos GSM.</p>
      <div class="hero-release" aria-label="Versión y plataforma">
        <strong>v2.2.3</strong>
        <span>Windows</span>
        <span>Licencia protegida</span>
      </div>

      <div class="hero-actions">
        <a href="#pricing" class={buttonVariants({ size: "lg", className: "shadow-lg shadow-primary/15" })}>
          Ver licencia
          <ArrowRight className="size-4" />
        </a>
        <button type="button" data-open-installer-access class={buttonVariants({ size: "lg", variant: "secondary" })}>
          <WindowsIcon className="size-4" />
          Descargar ArepaTool
        </button>
      </div>

      <div class="hero-proof" aria-label="Módulos principales">
        <span>FRP</span>
        <span>MDM</span>
        <span>iCloud</span>
        <span>DNS</span>
        <span>MTK</span>
      </div>
    </div>

    <div class="hero-visual">
      <figure class="hero-window">
        <div class="hero-window-bar" aria-hidden="true">
          <i></i><i></i><i></i><span>arepatool.exe · desktop workspace</span>
        </div>
        <img
          src="/pngs/landingdisplay.jpg"
          alt="Interfaz de ArepaTool v2.2.3 con módulos Samsung, Android, MediaTek, Apple y USB-Redirector"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<script>
  document.addEventListener("click", (event) => {
    if ((event.target as HTMLElement)?.closest("[data-open-installer-access]")) {
      window.dispatchEvent(new CustomEvent("open-installer-access"));
    }
  });
</script>
