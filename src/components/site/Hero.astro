---
import { ArrowRight } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { WindowsIcon } from "@/components/icons/BrandIcons";
import { getLocaleCopy, localeFromPath, localizedPath, type Locale } from "@/lib/i18n";

interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = getLocaleCopy(locale);
---

<section class="hero-section">
  <div class="site-container hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">{copy.hero.kicker}</p>
      <h1>ArepaTool <span>{copy.hero.titleAccent}</span></h1>
      <p>{copy.hero.description}</p>
      <div class="hero-release" aria-label="Versión y plataforma">
        <strong>v2.2.4</strong>
        <span>{copy.hero.platform}</span>
        <span>{copy.hero.license}</span>
      </div>

      <div class="hero-actions">
        <a href={localizedPath(locale, "/pricing")} class={buttonVariants({ size: "lg", className: "shadow-lg shadow-primary/15" })}>
          {copy.hero.licenseCta}
          <ArrowRight className="size-4" />
        </a>
        <button type="button" data-open-installer-access class={buttonVariants({ size: "lg", variant: "secondary" })}>
          <WindowsIcon className="size-4" />
          {copy.hero.downloadCta}
        </button>
      </div>

      <div class="hero-proof" aria-label={copy.hero.proofLabel}>
        <span>FRP</span>
        <span>MDM</span>
        <span>iCloud</span>
        <span>DNS</span>
        <span>MTK</span>
      </div>
    </div>

    <div class="hero-visual">
      <img
        class="hero-mascot"
        src="/pngs/windowslog.png"
        alt={copy.hero.mascotAlt}
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
  <p class="site-container hero-tagline">{copy.hero.tagline}</p>
</section>

<script>
  document.addEventListener("click", (event) => {
    if ((event.target as HTMLElement)?.closest("[data-open-installer-access]")) {
      window.dispatchEvent(new CustomEvent("open-installer-access"));
    }
  });
</script>
