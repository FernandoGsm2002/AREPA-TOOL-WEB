---
import { ArrowRight, Download, Check, Monitor } from 'lucide-react';
import { localeFromPath, localizedPath, type Locale } from '@/lib/i18n';
import { marketingCopy } from '@/lib/marketing-copy';
import ProductPreview from './ProductPreview.astro';
interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = marketingCopy[locale];
---
<section class="product-hero" aria-labelledby="hero-title">
  <div class="site-container product-hero__grid">
    <div class="product-hero__copy">
      <h1 id="hero-title">{copy.headline}<br /><span>{copy.accent}</span></h1>
      <p>{copy.intro}</p>
      <div class="product-hero__actions">
        <a class="marketing-button marketing-button--primary" href="https://api2.arepatool.com/api/app-version/download"><Download size={18} />{copy.download}</a>
        <a class="marketing-button marketing-button--secondary" href="#pricing">{copy.plans}<ArrowRight size={18} /></a>
      </div>
      <div class="product-hero__platform"><Monitor size={15} /><span>Windows</span><span>ArepaTool v3.1.0</span></div>
      <ul class="product-hero__proof">{copy.proof.map(item => <li><Check size={15} />{item}</li>)}</ul>
    </div>
    <ProductPreview locale={locale} />
  </div>
  <div class="site-container product-hero__foot"><p>{copy.brands}</p><a href={localizedPath(locale, '/supportedmodels')}>{copy.models}<ArrowRight size={16} /></a></div>
</section>
