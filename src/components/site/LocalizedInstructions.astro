---
import { CheckCircle2, Download, ShieldCheck, Wrench } from "lucide-react";
import { getLocaleCopy, localeFromPath, type Locale } from "@/lib/i18n";

interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = getLocaleCopy(locale);
const icons = [ShieldCheck, Download, Wrench, CheckCircle2];
---

<main class="site-page">
  <section class="docs-page site-container">
    <div class="page-heading">
      <h1>{copy.instructions.title}</h1>
      <p>{copy.instructions.description}</p>
    </div>
    <div class="instruction-grid">
      {copy.instructions.steps.map(([title, description], index) => {
        const Icon = icons[index];
        return (
          <article class="instruction-step">
            <span class="instruction-icon"><Icon className="size-5" /></span>
            <div><span class="instruction-number">{String(index + 1).padStart(2, "0")}</span><h2>{title}</h2><p>{description}</p></div>
          </article>
        );
      })}
    </div>
  </section>
</main>
