---
import { KeyRound, RotateCcw, Search } from "lucide-react";
import "@/styles/public-interior.css";
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/site/Navbar.astro";
import Footer from "@/components/site/Footer.astro";
import WhatsAppModal from "@/components/site/WhatsAppModal";
import TranssionModels from "@/components/site/TranssionModels";
import { androidVersions, supportedCombinations, testModels } from "@/lib/supported-models";
import { getLocaleCopy, localeFromPath, type Locale } from "@/lib/i18n";

interface Props { locale: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = getLocaleCopy(locale);
const byAndroid = androidVersions.map((android) => ({ android, models: supportedCombinations.filter((model) => model.android === android) }));
const totalModels = supportedCombinations.length + testModels.length;
---

<Layout title={`${copy.models.title} | ArepaTool`} description={copy.models.motorola} locale={locale} marketing>
  <Navbar locale={locale} />
  <main id="main-content" class="models-page public-interior">
    <div class="models-wrap">
      <header class="models-header"><h1>{copy.models.title}</h1><span>{totalModels}</span></header>
      <nav class="brand-nav" role="tablist" aria-label={copy.models.ariaBrands}>
        <button type="button" class="brand-tab is-active" role="tab" aria-selected="true" aria-controls="localized-motorola" data-localized-tab="localized-motorola"><span class="brand-mark">M</span>Motorola</button>
        <button type="button" class="brand-tab" role="tab" aria-selected="false" aria-controls="localized-transsion" data-localized-tab="localized-transsion"><span class="brand-mark transsion-mark">T</span>{copy.models.transsion}</button>
      </nav>

      <section id="localized-motorola" class="brand-stage" aria-label={copy.models.motorola}>
        <div class="catalog-controls" role="search">
          <label class="search-field"><Search className="size-4" /><input id="localized-model-search" type="search" placeholder={copy.models.search} aria-label={copy.models.search} autocomplete="off" /></label>
          <div class="android-filter" aria-label={copy.models.androidFilter}>
            <button type="button" class="is-selected" data-localized-version="all">{copy.models.all}</button>
            {androidVersions.map((android) => <button type="button" data-localized-version={android}>Android {android}</button>)}
          </div>
        </div>
        <p id="localized-catalog-status" class="catalog-status" aria-live="polite">{totalModels} {copy.models.visibleMany}</p>
        <div class="android-groups">
          {byAndroid.map(({ android, models }) => (
            <section class="android-group" data-localized-group={android}>
              <div class="android-heading"><span>Android {android}</span><i></i><small>{models.length}</small></div>
              <div class="model-grid">
                {models.map((model) => (
                  <article class="model-card" data-localized-model-card data-localized-android={android} data-localized-search={`${model.sku} ${model.name}`.toLowerCase()}>
                    <span class="model-sku">{model.sku}</span><h2>{model.name}</h2>
                    <div class="model-operations"><span><KeyRound className="size-3.5" /> {copy.models.operations.unlock}</span><span><RotateCcw className="size-3.5" /> {copy.models.operations.frp}</span></div>
                  </article>
                ))}
              </div>
            </section>
          ))}
          <section class="android-group" data-localized-group="test">
            <div class="android-heading"><span>{copy.models.test}</span><i></i><small>{testModels.length}</small></div>
            <div class="model-grid">
              {testModels.map((model) => (
                <article class="model-card test-card" data-localized-model-card data-localized-android="test" data-localized-search={`${model.sku} ${model.name} ${model.codename}`.toLowerCase()}>
                  <span class="model-sku">{model.sku}</span><h2>{model.name}</h2>
                  <div class="model-operations"><span><KeyRound className="size-3.5" /> {copy.models.operations.tempUnlock}</span><span><RotateCcw className="size-3.5" /> {copy.models.operations.frp}</span></div>
                </article>
              ))}
            </div>
          </section>
        </div>
        <p id="localized-catalog-empty" class="catalog-empty" hidden>{copy.models.empty}</p>
      </section>
      <div id="localized-transsion" role="tabpanel" hidden><TranssionModels client:load locale={locale} /></div>
    </div>
  </main>
  <Footer locale={locale} />
  <WhatsAppModal client:load locale={locale} />
<script define:vars={{ one: copy.models.visibleOne, many: copy.models.visibleMany }}>
  const filters = Array.from(document.querySelectorAll("[data-localized-version]"));
  const cards = Array.from(document.querySelectorAll("[data-localized-model-card]"));
  const groups = Array.from(document.querySelectorAll("[data-localized-group]"));
  const status = document.querySelector("#localized-catalog-status");
  const empty = document.querySelector("#localized-catalog-empty");
  const tabs = Array.from(document.querySelectorAll("[data-localized-tab]"));
  const panels = Array.from(document.querySelectorAll("#localized-motorola, #localized-transsion"));
  let selectedVersion = "all";
  const render = () => {
    const input = document.getElementById("localized-model-search");
    const query = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : "";
    let visible = 0;
    cards.forEach((card) => {
      const show = (selectedVersion === "all" || card.dataset.localizedAndroid === selectedVersion) && (!query || (card.dataset.localizedSearch ?? "").includes(query));
      card.hidden = !show;
      if (show) visible += 1;
    });
    groups.forEach((group) => { group.hidden = !group.querySelector("[data-localized-model-card]:not([hidden])"); });
    if (status) status.textContent = `${visible} ${visible === 1 ? one : many}`;
    if (empty) empty.hidden = visible !== 0;
  };
  document.addEventListener("input", (event) => {
    const target = event.target;
    if (target instanceof HTMLInputElement && target.id === "localized-model-search") render();
  });
  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target.closest("button") : null;
    if (!(target instanceof HTMLButtonElement)) return;
    if (target.matches("[data-localized-version]")) {
      selectedVersion = target.dataset.localizedVersion ?? "all";
      filters.forEach((item) => item.classList.toggle("is-selected", item === target));
      render();
      return;
    }
    if (!target.matches("[data-localized-tab]")) return;
    const selected = target.dataset.localizedTab;
    panels.forEach((panel) => { panel.hidden = panel.id !== selected; });
    tabs.forEach((item) => { const active = item === target; item.classList.toggle("is-active", active); item.setAttribute("aria-selected", String(active)); });
  });
</script>
</Layout>
