---
import { WhatsAppIcon } from "@/components/icons/BrandIcons";
---

<footer class="border-border/60 bg-card/35 border-t py-9">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 sm:flex-row sm:px-6">
    <p class="text-muted-foreground text-sm">© 2026 ArepaTool v2.1.2 — Desarrollado con ❤️</p>
    <div class="flex gap-5">
      <a href="#" class="text-muted-foreground hover:text-foreground text-sm">Términos</a>
      <a href="#" class="text-muted-foreground hover:text-foreground text-sm">Privacidad</a>
    </div>
  </div>
</footer>

<button
  type="button"
  data-open-wa
  aria-label="Abrir grupo de WhatsApp"
  class="fixed right-5 bottom-5 z-40 flex size-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl shadow-[#25D366]/30 transition-transform hover:scale-105"
>
  <WhatsAppIcon className="size-6" />
</button>

<script>
  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement)?.closest("[data-open-wa]");
    if (trigger) window.dispatchEvent(new CustomEvent("open-wa-modal"));
  });
</script>
