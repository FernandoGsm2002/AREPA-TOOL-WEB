---
import { getLocaleCopy, localeFromPath, type Locale } from "@/lib/i18n";

interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = getLocaleCopy(locale);
---

<section class="release-console-section" aria-labelledby="release-console-title">
  <div class="site-container">
    <div class="release-console-heading">
      <p class="release-console-kicker">{copy.release.kicker}</p>
      <h2 id="release-console-title">ArepaTool 3.0.3</h2>
      <p>{copy.release.whatsNew}</p>
    </div>

    <div class="release-console" role="region" aria-label="ArepaTool version 3.0.3 changelog">
      <div class="release-console__bar" aria-hidden="true">
        <span class="release-console__dot release-console__dot--red"></span>
        <span class="release-console__dot release-console__dot--yellow"></span>
        <span class="release-console__dot release-console__dot--green"></span>
        <span class="release-console__path">arepatool@workstation: ~/releases/3.0.3</span>
        <span class="release-console__status">{copy.release.stable}</span>
      </div>

      <pre class="release-console__code"><code><span class="terminal-line terminal-shebang">#!/usr/bin/env bash</span>
<span class="terminal-line terminal-comment"><strong class="terminal-strong"># AREPATOOL v3.0.3</strong></span>
<span class="terminal-line terminal-comment">SAMSUNG ROOT · FIXES · MORE RELIABLE UPDATES</span>

<span class="terminal-line terminal-heading"><strong class="terminal-strong"># NEW — AREPATOOL V3.0.3</strong></span>
<span class="terminal-line terminal-output"><strong>+ Samsung Root Files: 90+ tested files</strong></span>
<span class="terminal-line terminal-note">Includes a setup guide in the tool.</span>
<span class="terminal-line terminal-output"><strong>+ Improved Infinix META operations</strong></span>

<span class="terminal-line terminal-heading"><strong class="terminal-strong"># FIXES &amp; RELIABILITY</strong></span>
<span class="terminal-line terminal-fixed"><strong>✓ Fix Banking Apps 2026 bug fixes</strong></span>
<span class="terminal-line terminal-fixed"><strong>✓ Automatic update downloads fixed</strong></span>
<span class="terminal-line terminal-fixed"><strong>✓ Xiaomi Auth Sideload check before authorization</strong></span>
<span class="terminal-line terminal-note">Clear guidance when a charged result cannot be confirmed.</span>

<span class="terminal-line terminal-success"><strong>ROOT FILES | IMPROVED META | SMOOTHER UPDATES</strong></span>
<span class="terminal-line terminal-command"><span class="terminal-prompt">$</span> Website: www.arepatool.com</span>
<span class="terminal-line terminal-success"><strong>BUY NOW!</strong></span></code></pre>
    </div>
  </div>
</section>

<style>
  .release-console-section {
    border-bottom: 1px solid rgb(255 255 255 / 9%);
    background: #0d131b;
    padding-block: 4.5rem 5.5rem;
  }

  .release-console-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: .55rem 1rem;
    margin-bottom: 1.5rem;
  }

  .release-console-heading h2 {
    width: 100%;
    margin: 0;
    color: #f4f3ef;
    font-family: 'Avenir Next', 'Segoe UI', sans-serif;
    font-size: clamp(1.85rem, 4vw, 3rem);
    letter-spacing: -.055em;
  }

  .release-console-heading p:last-child {
    margin: 0;
    color: #aab3bd;
    font-size: .95rem;
  }

  .release-console-kicker,
  .release-console__status {
    color: #f4a64b;
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .release-console-kicker { width: 100%; margin: 0; }

  .release-console {
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 13%);
    border-radius: .65rem;
    background: #0a0f15 !important;
    color-scheme: dark;
    box-shadow: 0 22px 50px rgb(0 0 0 / 28%);
  }

  .release-console__bar {
    display: flex;
    min-height: 2.65rem;
    align-items: center;
    gap: .45rem;
    padding-inline: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    background: #111821;
    color: #aab3bd;
    font-family: var(--font-mono);
    font-size: .67rem;
  }

  .release-console__dot { width: .5rem; height: .5rem; border-radius: 50%; }
  .release-console__dot--red { background: #e87878; }
  .release-console__dot--yellow { background: #e7bd68; }
  .release-console__dot--green { background: #75c49a; }
  .release-console__path { margin-left: .45rem; }
  .release-console__status { margin-left: auto; color: #75c49a; font-size: .6rem; }

  .release-console__code {
    max-height: 34rem;
    overflow: auto;
    margin: 0;
    padding: 1.35rem clamp(1rem, 3vw, 2rem) 1.6rem;
    background: #0a0f15 !important;
    color: #dbe1e7;
    font-family: var(--font-mono);
    font-size: clamp(.69rem, 1.2vw, .8rem);
    line-height: 1.75;
    white-space: pre-wrap;
  }

  .release-console__code code { background: transparent !important; color: inherit; }
  .terminal-line { display: block; opacity: 0; transform: translateY(.2rem); animation: terminal-line-in .34s ease-out var(--line-delay, 0ms) forwards; }
  .terminal-shebang { color: #f4c274; }
  .terminal-strong { font-weight: 800; }
  .terminal-command { color: #dbe1e7; }
  .terminal-prompt { color: #f4a64b; }
  .terminal-comment { color: #aab3bd; }
  .terminal-heading { color: #9dc9f2; }
  .terminal-brand { color: #d7a9e8; }
  .terminal-variable { color: #9dc9f2; }
  .terminal-output { color: #8de0b4; }
  .terminal-cpu { color: #9dc9f2; }
  .terminal-note { color: #d9c4a4; }
  .terminal-warning { color: #ffd47f; }
  .terminal-fixed { color: #7fd7dc; }
  .terminal-success { color: #8de0b4; }

  @keyframes terminal-line-in {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .release-console__code { scroll-behavior: auto; }
    .terminal-line { opacity: 1; transform: none; animation: none; }
  }
</style>

<script>
  const releaseLines = document.querySelectorAll<HTMLElement>(".release-console__code .terminal-line");
  releaseLines.forEach((line, index) => {
    line.style.setProperty("--line-delay", `${index * 42}ms`);
  });
</script>
