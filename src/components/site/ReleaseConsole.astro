---
import { getLocaleCopy, localeFromPath, type Locale } from "@/lib/i18n";

interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = getLocaleCopy(locale);
---

<section class="release-console-section" aria-labelledby="release-console-title">
  <div class="site-container">
    <div class="release-console-heading">
      <p class="release-console-kicker">{copy.release.kicker}</p>
      <h2 id="release-console-title">ArepaTool 2.2.6</h2>
      <p>{copy.release.whatsNew}</p>
    </div>

    <div class="release-console" role="region" aria-label="ArepaTool version 2.2.6 changelog">
      <div class="release-console__bar" aria-hidden="true">
        <span class="release-console__dot release-console__dot--red"></span>
        <span class="release-console__dot release-console__dot--yellow"></span>
        <span class="release-console__dot release-console__dot--green"></span>
        <span class="release-console__path">arepatool@workstation: ~/releases/2.2.6</span>
        <span class="release-console__status">{copy.release.stable}</span>
      </div>

      <pre class="release-console__code"><code><span class="terminal-line terminal-shebang">#!/usr/bin/env bash</span>
<span class="terminal-line terminal-comment"><strong class="terminal-strong"># AREPATOOL v2.2.6</strong></span>
<span class="terminal-line terminal-comment">MDM NEW UPDATE</span>
<span class="terminal-line terminal-comment">MORE BRANDS · MORE SOLUTIONS · KEEP MOVING FORWARD</span>

<span class="terminal-line terminal-heading"><strong class="terminal-strong"># NEW — ADDED NEW BUTTONS</strong></span>
<span class="terminal-line terminal-output"><strong>- MDM QR</strong></span>
<span class="terminal-line terminal-output"><strong>- ADB</strong></span>

<span class="terminal-line terminal-heading"><strong class="terminal-strong"># SUPPORTED OPERATIONS</strong></span>
<span class="terminal-line terminal-output"><strong>IT ADMIN — SUPPORTED</strong></span>
<span class="terminal-line terminal-note">Bypass and manage enterprise devices.</span>
<span class="terminal-line terminal-output"><strong>KRECE — SUPPORTED</strong></span>
<span class="terminal-line terminal-note">Remove / Bypass Krece MDM.</span>
<span class="terminal-line terminal-output"><strong>CLARO / TELCEL — SUPPORTED</strong></span>
<span class="terminal-line terminal-note">Full support for Claro and Telcel devices.</span>
<span class="terminal-line terminal-warning"><strong>KG — NOT SUPPORTED</strong></span>
<span class="terminal-line terminal-warning">KG devices are not supported.</span>
<span class="terminal-line terminal-output"><strong>WHITE SCREEN MOTOROLA — SUPPORTED</strong></span>
<span class="terminal-line terminal-note">Fix White Screen on Motorola devices.</span>
<span class="terminal-line terminal-output"><strong>CRICKET MOTO — SUPPORTED</strong></span>
<span class="terminal-line terminal-note">No need DNS. Direct support.</span>

<span class="terminal-line terminal-heading"><strong class="terminal-strong"># MINOR UPDATE</strong></span>
<span class="terminal-line terminal-fixed"><strong>Fixed Xiaomi — improved with Xiaomi Auth.</strong></span>

<span class="terminal-line terminal-success"><strong>FAST | STABLE | MORE BRANDS | MORE SOLUTIONS</strong></span>
<span class="terminal-line terminal-command"><span class="terminal-prompt">$</span> Website: www.arepatool.com</span>
<span class="terminal-line terminal-success"><strong>BUY NOW!</strong></span></code></pre>
    </div>
  </div>
</section>

<style>
  .release-console-section {
    border-bottom: 1px solid rgb(23 34 45 / 12%);
    background: #e9e8e1;
    padding-block: 4.5rem 5.5rem;
  }

  .release-console-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: .55rem 1rem;
    margin-bottom: 1.5rem;
  }

  .release-console-heading h2 {
    width: 100%;
    margin: 0;
    color: #17222d;
    font-family: 'Avenir Next', 'Segoe UI', sans-serif;
    font-size: clamp(1.85rem, 4vw, 3rem);
    letter-spacing: -.055em;
  }

  .release-console-heading p:last-child {
    margin: 0;
    color: #65727c;
    font-size: .95rem;
  }

  .release-console-kicker,
  .release-console__status {
    color: #a27a23;
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .release-console-kicker { width: 100%; margin: 0; }

  .release-console {
    overflow: hidden;
    border: 1px solid #c8c6bc;
    border-radius: .65rem;
    background: #f8f7f1 !important;
    color-scheme: light;
    box-shadow: 0 22px 50px rgb(23 34 45 / 14%);
  }

  .release-console__bar {
    display: flex;
    min-height: 2.65rem;
    align-items: center;
    gap: .45rem;
    padding-inline: 1rem;
    border-bottom: 1px solid #cfcdc4;
    background: #e1e0d8;
    color: #68737b;
    font-family: var(--font-mono);
    font-size: .67rem;
  }

  .release-console__dot { width: .5rem; height: .5rem; border-radius: 50%; }
  .release-console__dot--red { background: #e87878; }
  .release-console__dot--yellow { background: #e7bd68; }
  .release-console__dot--green { background: #75c49a; }
  .release-console__path { margin-left: .45rem; }
  .release-console__status { margin-left: auto; color: #75c49a; font-size: .6rem; }

  .release-console__code {
    max-height: 34rem;
    overflow: auto;
    margin: 0;
    padding: 1.35rem clamp(1rem, 3vw, 2rem) 1.6rem;
    background: #f8f7f1 !important;
    color: #34404a;
    font-family: var(--font-mono);
    font-size: clamp(.69rem, 1.2vw, .8rem);
    line-height: 1.75;
    white-space: pre-wrap;
  }

  .release-console__code code { background: transparent !important; color: inherit; }
  .terminal-line { display: block; opacity: 0; transform: translateY(.2rem); animation: terminal-line-in .34s ease-out var(--line-delay, 0ms) forwards; }
  .terminal-shebang { color: #7e5c17; }
  .terminal-strong { font-weight: 800; }
  .terminal-command { color: #263641; }
  .terminal-prompt { color: #aa7618; }
  .terminal-comment { color: #7b858b; }
  .terminal-heading { color: #476d91; }
  .terminal-brand { color: #7d4f8f; }
  .terminal-variable { color: #476d91; }
  .terminal-output { color: #327b59; }
  .terminal-cpu { color: #416f9a; }
  .terminal-note { color: #7c6b4d; }
  .terminal-warning { color: #a16b14; }
  .terminal-fixed { color: #2b7b83; }
  .terminal-success { color: #327b59; }

  @keyframes terminal-line-in {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .release-console__code { scroll-behavior: auto; }
    .terminal-line { opacity: 1; transform: none; animation: none; }
  }
</style>

<script>
  const releaseLines = document.querySelectorAll<HTMLElement>(".release-console__code .terminal-line");
  releaseLines.forEach((line, index) => {
    line.style.setProperty("--line-delay", `${index * 42}ms`);
  });
</script>
