---
import { ArrowRight, ChevronDown } from 'lucide-react';
import { changelog } from '@/lib/site-data';
import { getLocaleCopy, localeFromPath, localizedPath, type Locale } from '@/lib/i18n';
import { marketingCopy } from '@/lib/marketing-copy';
interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = marketingCopy[locale];
const nextRelease = changelog.findIndex((line, index) => index > 0 && line.type === 'h1');
const releaseLines = nextRelease < 0 ? changelog : changelog.slice(0, nextRelease);
---
<section class="release-showcase" aria-labelledby="release-title">
  <div class="site-container release-showcase__grid">
    <div class="marketing-heading">
      <h2 id="release-title">{copy.latest}</h2>
      <p>{copy.releaseIntro}</p>
      <a class="marketing-text-link" href={localizedPath(locale, '/updates')}>{copy.releaseAction}<ArrowRight size={17} /></a>
    </div>
    <div class="release-showcase__content">
      <div class="release-showcase__version"><strong>ArepaTool v3.1.0</strong><time datetime="2026-11-16">16.11.2026</time></div>
      <h3>Motorola MTK <span>Repair IMEI · ADB</span></h3>
      <p>Moto G05 · G15 · G15 Power · E15 · G24 · G24 Power · G22</p>
      <h3>Samsung MTK V6 <span>FRP · Download Mode</span></h3>
      <p>{getLocaleCopy(locale).hero.description}</p>
      <details class="release-notes"><summary>{copy.releaseDetails}<ChevronDown size={18} /></summary>
        <div>{releaseLines.map(line => line.type === 'blank' ? <br /> : line.type === 'h1' || line.type === 'h2' ? <h4>{line.text.replace(/^#\s*/, '')}</h4> : <p>{line.text}</p>)}</div>
      </details>
    </div>
  </div>
</section>
