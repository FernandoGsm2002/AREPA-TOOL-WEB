---
import { resellers } from "@/lib/site-data";
import ResellerCard from "@/components/site/ResellerCard.astro";

const distributor = resellers.filter((reseller) => reseller.role === "distributor");
const resellerList = resellers.filter((reseller) => reseller.role === "reseller");
---

<section id="resellers" class="section-plain">
  <div class="site-container resellers-layout">
  <div class="section-heading">
    <h2>Habla con un distribuidor verificado.</h2>
    <p>Compra tu licencia directamente con los contactos oficiales de ArepaTool. El panel no cobra ni procesa pagos.</p>
  </div>

  <div class="mx-auto mt-10 max-w-sm">
    <h3 class="font-display mb-4 text-lg font-bold">Distribuidor oficial</h3>
    {
      distributor.map((reseller) => <ResellerCard reseller={reseller} verifiedLabel="Oficial" />)
    }
  </div>

  <div class="border-border/60 my-12 border-t sm:my-16"></div>

  <h3 class="font-display text-2xl font-bold tracking-[-0.03em] sm:text-3xl">Resellers oficiales</h3>
  <div class="reseller-grid mt-7">
    {
      resellerList.map((reseller) => <ResellerCard reseller={reseller} verifiedLabel="Reseller" />)
    }
  </div>
  </div>
</section>
