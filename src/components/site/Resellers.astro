---
import { BadgeCheck, Globe } from "lucide-react";
import { resellers } from "@/lib/site-data";
import { WhatsAppIcon, TelegramIcon } from "@/components/icons/BrandIcons";

const iconFor = { whatsapp: WhatsAppIcon, telegram: TelegramIcon, globe: Globe };
---

<section id="resellers" class="mx-auto max-w-7xl px-4 py-18 pb-24 sm:px-6">
  <h2 class="font-display text-center text-3xl font-bold tracking-[-0.04em] sm:text-5xl">Distribuidores Oficiales</h2>

  <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      resellers.map((reseller) => {
        return (
          <div class="border-border/60 bg-card relative rounded-2xl border p-6 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/8">
            <span class="absolute top-3 right-3" title="Distribuidor Verificado">
              <BadgeCheck className="text-primary size-5" />
            </span>
            <img src={reseller.logo} alt={reseller.name} class="mx-auto h-16 w-16 rounded-lg object-cover" />
            <h4 class="mt-3 font-semibold">{reseller.name}</h4>
            <p class="text-muted-foreground mt-1 flex items-center justify-center gap-1 text-xs">
              <Globe className="size-3.5" />
              {reseller.region}
            </p>
            <p class="text-primary mt-1 text-xs font-semibold">{reseller.payments}</p>
            <div class="mt-3 flex justify-center gap-2">
              {reseller.links.map((link) => {
                const LinkIcon = iconFor[link.icon];
                return (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border-border/60 hover:border-primary hover:text-primary text-muted-foreground flex size-9 items-center justify-center rounded-full border transition-colors"
                  >
                    <LinkIcon className="size-4" />
                  </a>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
