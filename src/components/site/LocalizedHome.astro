---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/site/Navbar.astro";
import AnnouncementBanner from "@/components/site/AnnouncementBanner.astro";
import BrandMarquee from "@/components/site/BrandMarquee.astro";
import Hero from "@/components/site/Hero.astro";
import ReleaseConsole from "@/components/site/ReleaseConsole.astro";
import Pricing from "@/components/site/Pricing.astro";
import Footer from "@/components/site/Footer.astro";
import WhatsAppModal from "@/components/site/WhatsAppModal";
import UpdateLaunchModal from "@/components/site/UpdateLaunchModal";
import type { Locale } from "@/lib/i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const metadata = {
  es: { title: "ArepaTool 3.0.3 - Samsung Root Files y mejoras", description: "ArepaTool 3.0.3 añade Samsung Root Files, mejora META de Infinix y corrige Fix Banking Apps y las actualizaciones automáticas." },
  en: { title: "ArepaTool 3.0.3 - Samsung Root Files and fixes", description: "ArepaTool 3.0.3 adds Samsung Root Files, improves Infinix META and fixes Fix Banking Apps and automatic update downloads." },
  "pt-br": { title: "ArepaTool 3.0.3 - Samsung Root Files e melhorias", description: "ArepaTool 3.0.3 adiciona Samsung Root Files, melhora META da Infinix e corrige Fix Banking Apps e downloads de atualizações." },
}[locale];
---

<Layout title={metadata.title} description={metadata.description} locale={locale}>
  <Navbar locale={locale} />
  <AnnouncementBanner locale={locale} />
  <main class="landing-shell"><Hero locale={locale} /></main>
  <BrandMarquee />
  <ReleaseConsole locale={locale} />
  <Pricing locale={locale} />
  <Footer locale={locale} />
  <WhatsAppModal client:load locale={locale} />
  <UpdateLaunchModal client:load locale={locale} />
</Layout>
