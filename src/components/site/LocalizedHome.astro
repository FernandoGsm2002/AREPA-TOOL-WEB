---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/site/Navbar.astro";
import AnnouncementBanner from "@/components/site/AnnouncementBanner.astro";
import BrandMarquee from "@/components/site/BrandMarquee.astro";
import Hero from "@/components/site/Hero.astro";
import ReleaseConsole from "@/components/site/ReleaseConsole.astro";
import Pricing from "@/components/site/Pricing.astro";
import Footer from "@/components/site/Footer.astro";
import WhatsAppModal from "@/components/site/WhatsAppModal";
import UpdateLaunchModal from "@/components/site/UpdateLaunchModal";
import type { Locale } from "@/lib/i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const metadata = {
  es: { title: "ArepaTool v3.0.9 · Christmas Edition", description: "ArepaTool v3.0.9 Christmas Edition: nuevas operaciones Motorola MTK, Infinix SPD y MTK, mejoras Samsung y nueva interfaz." },
  en: { title: "ArepaTool v3.0.9 · Christmas Edition", description: "ArepaTool v3.0.9 Christmas Edition adds Motorola MTK, Infinix SPD and MTK operations, Samsung improvements and a refreshed UI." },
  "pt-br": { title: "ArepaTool v3.0.9 · Christmas Edition", description: "ArepaTool v3.0.9 Christmas Edition: novas operações Motorola MTK, Infinix SPD e MTK, melhorias Samsung e nova interface." },
}[locale];
---

<Layout title={metadata.title} description={metadata.description} locale={locale}>
  <Navbar locale={locale} />
  <AnnouncementBanner locale={locale} />
  <main class="landing-shell"><Hero locale={locale} /></main>
  <BrandMarquee />
  <ReleaseConsole locale={locale} />
  <Pricing locale={locale} />
  <Footer locale={locale} />
  <WhatsAppModal client:load locale={locale} />
  <UpdateLaunchModal client:load locale={locale} />
</Layout>
