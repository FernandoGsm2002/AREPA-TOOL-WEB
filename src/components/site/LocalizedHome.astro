---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/site/Navbar.astro";
import AnnouncementBanner from "@/components/site/AnnouncementBanner.astro";
import BrandMarquee from "@/components/site/BrandMarquee.astro";
import Hero from "@/components/site/Hero.astro";
import ReleaseConsole from "@/components/site/ReleaseConsole.astro";
import Pricing from "@/components/site/Pricing.astro";
import Footer from "@/components/site/Footer.astro";
import WhatsAppModal from "@/components/site/WhatsAppModal";
import UpdateLaunchModal from "@/components/site/UpdateLaunchModal";
import HomeGuide from "./HomeGuide.astro";
import type { Locale } from "@/lib/i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const metadata = {
  es: { title: "ArepaTool v3.1.0", description: "ArepaTool v3.1.0: Repair IMEI ADB Motorola MTK y Samsung FRP MTK V6 en Download Mode." },
  en: { title: "ArepaTool v3.1.0", description: "ArepaTool v3.1.0: Motorola MTK ADB IMEI repair and Samsung MTK V6 FRP in Download Mode." },
  "pt-br": { title: "ArepaTool v3.1.0", description: "ArepaTool v3.1.0: Repair IMEI ADB Motorola MTK e Samsung FRP MTK V6 em Download Mode." },
}[locale];
---

<Layout title={metadata.title} description={metadata.description} locale={locale} marketing>
  <Navbar locale={locale} />
  <main id="main-content">
    <Hero locale={locale} />
    <BrandMarquee />
    <AnnouncementBanner locale={locale} />
    <HomeGuide locale={locale} part="resources" />
    <Pricing locale={locale} />
    <ReleaseConsole locale={locale} />
    <HomeGuide locale={locale} part="start" />
  </main>
  <Footer locale={locale} />
  <WhatsAppModal client:load locale={locale} />
  <UpdateLaunchModal client:load locale={locale} />
</Layout>
