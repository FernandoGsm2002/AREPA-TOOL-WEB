---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/site/Navbar.astro";
import AnnouncementBanner from "@/components/site/AnnouncementBanner.astro";
import BrandMarquee from "@/components/site/BrandMarquee.astro";
import Hero from "@/components/site/Hero.astro";
import ReleaseConsole from "@/components/site/ReleaseConsole.astro";
import Pricing from "@/components/site/Pricing.astro";
import Footer from "@/components/site/Footer.astro";
import WhatsAppModal from "@/components/site/WhatsAppModal";
import UpdateLaunchModal from "@/components/site/UpdateLaunchModal";
import type { Locale } from "@/lib/i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const metadata = {
  es: { title: "ArepaTool 2.2.9 - Professional Unlock & MDM Tool", description: "ArepaTool 2.2.9 añade términos y condiciones actualizados, correcciones en Xiaomi FRP Auth y actualización automática." },
  en: { title: "ArepaTool 2.2.9 - Professional Unlock & MDM Tool", description: "ArepaTool 2.2.9 adds updated terms and conditions, Xiaomi FRP Auth fixes, and automatic version updates." },
  "pt-br": { title: "ArepaTool 2.2.9 - Ferramenta profissional de Unlock e MDM", description: "A ArepaTool 2.2.9 adiciona termos e condições atualizados, correções no Xiaomi FRP Auth e atualização automática." },
}[locale];
---

<Layout title={metadata.title} description={metadata.description} locale={locale}>
  <Navbar locale={locale} />
  <AnnouncementBanner locale={locale} />
  <main class="landing-shell"><Hero locale={locale} /></main>
  <BrandMarquee />
  <ReleaseConsole locale={locale} />
  <Pricing locale={locale} />
  <Footer locale={locale} />
  <WhatsAppModal client:load locale={locale} />
  <UpdateLaunchModal client:load locale={locale} />
</Layout>
