---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/site/Navbar.astro";
import AnnouncementBanner from "@/components/site/AnnouncementBanner.astro";
import BrandMarquee from "@/components/site/BrandMarquee.astro";
import Hero from "@/components/site/Hero.astro";
import ReleaseConsole from "@/components/site/ReleaseConsole.astro";
import Pricing from "@/components/site/Pricing.astro";
import Footer from "@/components/site/Footer.astro";
import WhatsAppModal from "@/components/site/WhatsAppModal";
import InstallerAccessModal from "@/components/site/InstallerAccessModal";
import UpdateLaunchModal from "@/components/site/UpdateLaunchModal";
import type { Locale } from "@/lib/i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const metadata = {
  es: { title: "ArepaTool 2.2.5 - Professional Unlock & MDM Tool", description: "ArepaTool 2.2.5 añade Xiaomi FRP Auth, herramientas Meta Mode, mejoras de PayJoy y soporte Apple Rust AIO." },
  en: { title: "ArepaTool 2.2.5 - Professional Unlock & MDM Tool", description: "ArepaTool 2.2.5 adds Xiaomi FRP Auth, Meta Mode tools, PayJoy improvements and Apple Rust AIO support." },
  "pt-br": { title: "ArepaTool 2.2.5 - Ferramenta profissional de Unlock e MDM", description: "A ArepaTool 2.2.5 adiciona Xiaomi FRP Auth, ferramentas Meta Mode, melhorias PayJoy e suporte Apple Rust AIO." },
}[locale];
---

<Layout title={metadata.title} description={metadata.description} locale={locale}>
  <Navbar locale={locale} />
  <AnnouncementBanner locale={locale} />
  <main class="landing-shell"><Hero locale={locale} /></main>
  <BrandMarquee />
  <ReleaseConsole locale={locale} />
  <Pricing locale={locale} />
  <Footer locale={locale} />
  <WhatsAppModal client:load locale={locale} />
  <UpdateLaunchModal client:load locale={locale} />
  <InstallerAccessModal client:load locale={locale} />
</Layout>
