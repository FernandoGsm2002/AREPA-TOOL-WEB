---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/site/Navbar.astro";
import AnnouncementBanner from "@/components/site/AnnouncementBanner.astro";
import BrandMarquee from "@/components/site/BrandMarquee.astro";
import Hero from "@/components/site/Hero.astro";
import ReleaseConsole from "@/components/site/ReleaseConsole.astro";
import Pricing from "@/components/site/Pricing.astro";
import Footer from "@/components/site/Footer.astro";
import WhatsAppModal from "@/components/site/WhatsAppModal";
import UpdateLaunchModal from "@/components/site/UpdateLaunchModal";
import type { Locale } from "@/lib/i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const metadata = {
  es: { title: "ArepaTool 3.0.2 - Big Update", description: "ArepaTool 3.0.2 presenta una nueva interfaz, un flujo más sencillo para usuarios inexpertos, mejoras generales y actualización automática." },
  en: { title: "ArepaTool 3.0.2 - Big Update", description: "ArepaTool 3.0.2 introduces a new interface, a simpler workflow for new users, general improvements, and automatic updates." },
  "pt-br": { title: "ArepaTool 3.0.2 - Big Update", description: "A ArepaTool 3.0.2 apresenta uma nova interface, fluxo simplificado para novos usuários, melhorias gerais e atualização automática." },
}[locale];
---

<Layout title={metadata.title} description={metadata.description} locale={locale}>
  <Navbar locale={locale} />
  <AnnouncementBanner locale={locale} />
  <main class="landing-shell"><Hero locale={locale} /></main>
  <BrandMarquee />
  <ReleaseConsole locale={locale} />
  <Pricing locale={locale} />
  <Footer locale={locale} />
  <WhatsAppModal client:load locale={locale} />
  <UpdateLaunchModal client:load locale={locale} />
</Layout>
