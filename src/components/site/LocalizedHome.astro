---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/site/Navbar.astro";
import AnnouncementBanner from "@/components/site/AnnouncementBanner.astro";
import BrandMarquee from "@/components/site/BrandMarquee.astro";
import Hero from "@/components/site/Hero.astro";
import ReleaseConsole from "@/components/site/ReleaseConsole.astro";
import Pricing from "@/components/site/Pricing.astro";
import Footer from "@/components/site/Footer.astro";
import WhatsAppModal from "@/components/site/WhatsAppModal";
import InstallerAccessModal from "@/components/site/InstallerAccessModal";
import UpdateLaunchModal from "@/components/site/UpdateLaunchModal";
import type { Locale } from "@/lib/i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const metadata = {
  es: { title: "ArepaTool 2.2.7 - Professional Unlock & MDM Tool", description: "ArepaTool 2.2.7 añade operaciones ZTE y Nubia Unisoc en beta, además de correcciones de estabilidad y compatibilidad para Transsion Metamode." },
  en: { title: "ArepaTool 2.2.7 - Professional Unlock & MDM Tool", description: "ArepaTool 2.2.7 adds ZTE and Nubia Unisoc operations in beta, plus stability and compatibility fixes for Transsion Metamode." },
  "pt-br": { title: "ArepaTool 2.2.7 - Ferramenta profissional de Unlock e MDM", description: "A ArepaTool 2.2.7 adiciona operações ZTE e Nubia Unisoc em beta, além de correções de estabilidade e compatibilidade no Transsion Metamode." },
}[locale];
---

<Layout title={metadata.title} description={metadata.description} locale={locale}>
  <Navbar locale={locale} />
  <AnnouncementBanner locale={locale} />
  <main class="landing-shell"><Hero locale={locale} /></main>
  <BrandMarquee />
  <ReleaseConsole locale={locale} />
  <Pricing locale={locale} />
  <Footer locale={locale} />
  <WhatsAppModal client:load locale={locale} />
  <UpdateLaunchModal client:load locale={locale} />
  <InstallerAccessModal client:load locale={locale} />
</Layout>
