---
import { Play } from "lucide-react";
import { tutorials } from "@/lib/site-data";
---

<section id="tutorials" class="mx-auto max-w-7xl px-4 py-18 sm:px-6">
  <h2 class="font-display text-center text-3xl font-bold tracking-[-0.04em] sm:text-5xl">
    Tutoriales <span class="text-primary">Oficiales</span>
  </h2>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      tutorials.map((tutorial) => (
        <button
          type="button"
          class="group text-left"
          data-video-card
          data-video-id={tutorial.videoId}
        >
          <div class="border-border/60 bg-muted relative aspect-video overflow-hidden rounded-2xl border shadow-lg transition-shadow group-hover:shadow-primary/15" data-video-container>
            <img
              src={`https://img.youtube.com/vi/${tutorial.videoId}/hqdefault.jpg`}
              alt={tutorial.title}
              class="size-full object-cover transition-transform group-hover:scale-105"
              loading="lazy"
            />
            <div class="bg-primary text-primary-foreground absolute inset-0 m-auto flex size-14 items-center justify-center rounded-full shadow-lg">
              <Play className="ml-0.5 size-6 fill-current" />
            </div>
          </div>
          <h4 class="text-foreground/90 mt-3 text-center text-base font-semibold">{tutorial.title}</h4>
        </button>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-video-card]").forEach((card) => {
    card.addEventListener("click", () => {
      const videoId = card.dataset.videoId;
      const container = card.querySelector<HTMLElement>("[data-video-container]");
      if (!container || !videoId) return;
      container.innerHTML = `<iframe class="size-full" src="https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
    });
  });
</script>
