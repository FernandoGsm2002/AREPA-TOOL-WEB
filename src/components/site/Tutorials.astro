---
import { Play } from "lucide-react";
import { tutorials } from "@/lib/site-data";
import { getLocaleCopy, localeFromPath, type Locale } from "@/lib/i18n";

interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = getLocaleCopy(locale);
---

<section id="tutorials" class="section-plain" data-video-title={copy.tutorials.videoTitle}>
  <div class="site-container tutorials-layout">
    <div class="section-heading">
      <h2>{copy.tutorials.title}</h2>
      <p>{copy.tutorials.description}</p>
    </div>

  <div class="tutorial-grid">
    {
      tutorials.map((tutorial) => (
        <button
          type="button"
          class="tutorial-card"
          data-video-card
          data-video-id={tutorial.videoId}
        >
          <div class="tutorial-thumbnail" data-video-container>
            <img
              src={`https://img.youtube.com/vi/${tutorial.videoId}/hqdefault.jpg`}
              alt={tutorial.title}
              class="tutorial-image"
              loading="lazy"
            />
            <div class="tutorial-play">
              <Play className="ml-0.5 size-6 fill-current" />
            </div>
          </div>
          <h4 class="tutorial-title">{tutorial.title}</h4>
        </button>
      ))
    }
  </div>
  </div>
</section>

<script>
  const videoTitle = document.getElementById("tutorials")?.dataset.videoTitle ?? "YouTube video";
  document.querySelectorAll<HTMLElement>("[data-video-card]").forEach((card) => {
    card.addEventListener("click", () => {
      const videoId = card.dataset.videoId;
      const container = card.querySelector<HTMLElement>("[data-video-container]");
      if (!container || !videoId) return;
      container.innerHTML = `<iframe class="size-full" src="https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0" title="${videoTitle}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
    });
  });
</script>
