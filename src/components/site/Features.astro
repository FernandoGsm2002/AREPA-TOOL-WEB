---
import { Apple, CircuitBoard, Database, Download, Gauge, LockKeyhole, RadioTower, ShieldCheck, Smartphone, Wifi } from "lucide-react";
import { featureCopy } from "@/lib/i18n";
import { localeFromPath, type Locale } from "@/lib/i18n";

interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const featureIcons = [CircuitBoard, ShieldCheck, Download, Smartphone, RadioTower, Database, Gauge, Wifi, LockKeyhole, Apple];
const content = featureCopy[locale];
const groups = content.groups.map((group, index) => ({ ...group, icon: featureIcons[index] }));
---

<section id="features" class="features-page">
  <div class="site-container features-layout">
    <div class="features-quickbar" aria-label="Core protocols">
      {content.quick.map((item) => <span>{item}</span>)}
    </div>

    <div class="feature-groups">
      {groups.map((group) => {
        const Icon = group.icon;
        return (
          <article class:list={["feature-cluster", group.wide && "feature-cluster--wide"]}>
            <div class="feature-cluster__header">
              <span class="feature-cluster__icon"><Icon aria-hidden="true" /></span>
              <div><p class="feature-cluster__eyebrow">{group.eyebrow}</p><h2>{group.title}</h2></div>
            </div>
            <ul class:list={["feature-list", group.wide && "feature-list--columns"]}>
              {group.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
        );
      })}
    </div>

    <p class="features-note">{content.note}</p>
  </div>
</section>

<style>
  .features-page {
    background: #f1f0ea;
    color: #17222d;
  }

  .features-layout {
    padding-block: 4.5rem 7rem;
  }

  .feature-cluster__eyebrow {
    color: #b65b15;
    font-family: var(--font-mono);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .features-quickbar {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    margin-top: 0;
  }

  .features-quickbar span {
    border: 1px solid #e0b47a;
    border-radius: 999px;
    background: #fff0dc;
    padding: .5rem .75rem;
    color: #8f4b12;
    font-family: var(--font-mono);
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .04em;
  }

  .feature-groups {
    display: grid;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .feature-cluster {
    border-top: 2px solid #e98a24;
    background: #fffaf2;
    padding: 1.35rem 1.25rem 1.5rem;
    box-shadow: 0 12px 28px rgb(90 53 24 / 6%);
  }

  .feature-cluster__header {
    display: flex;
    align-items: center;
    gap: .85rem;
  }

  .feature-cluster__icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid #efc992;
    border-radius: .8rem;
    background: #fff0dc;
    color: #c76516;
  }

  .feature-cluster__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .feature-cluster h2 {
    margin-top: .25rem;
    color: #3e2a1c;
    font-family: 'Avenir Next', 'Segoe UI', sans-serif;
    font-size: 1.25rem;
    letter-spacing: -.035em;
  }

  .feature-list {
    display: grid;
    gap: .6rem;
    margin-top: 1.25rem;
    padding-left: 1.1rem;
    color: #665548;
    font-size: .86rem;
    line-height: 1.55;
  }

  .feature-list li::marker {
    color: #d97819;
  }

  .features-note {
    max-width: 50rem;
    margin-top: 2rem;
    color: #7a6a5d;
    font-size: .78rem;
    line-height: 1.6;
  }

  @media (min-width: 700px) {
    .feature-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature-cluster--wide {
      grid-column: span 2;
    }

    .feature-list--columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  @media (min-width: 1100px) {
    .feature-groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .feature-cluster--wide {
      grid-column: span 3;
    }
  }

  @media (max-width: 699px) {
    .features-layout {
      padding-block: 3rem 4.5rem;
    }

    .features-quickbar {
      gap: .45rem;
    }

    .features-quickbar span {
      padding: .42rem .62rem;
      font-size: .61rem;
    }

    .feature-groups {
      gap: .8rem;
      margin-top: 1.75rem;
    }

    .feature-cluster {
      padding: 1.2rem 1rem 1.3rem;
    }

    .feature-cluster__header {
      align-items: flex-start;
      gap: .7rem;
    }

    .feature-cluster__icon {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: .75rem;
    }

    .feature-cluster h2 {
      font-size: 1.08rem;
    }

    .feature-list {
      gap: .5rem;
      margin-top: 1rem;
      font-size: .8rem;
    }

    .features-note {
      margin-top: 1.5rem;
      font-size: .72rem;
    }
  }
</style>
