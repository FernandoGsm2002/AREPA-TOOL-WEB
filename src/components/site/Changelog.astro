---
import { changelog } from "@/lib/site-data";
import { getLocaleCopy, localeFromPath, type Locale } from "@/lib/i18n";

interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = getLocaleCopy(locale);
const liveLabel = locale === "es" ? "● registro de cambios activo" : locale === "pt-br" ? "● registro de alterações ativo" : "● live changelog";
const changelogFile = locale === "es" ? "REGISTRO.md" : locale === "pt-br" ? "ALTERACOES.md" : "CHANGELOG.md";

const lineClass: Record<string, string> = {
  h1: "text-orange-300 font-bold",
  comment: "text-slate-400 italic",
  h2: "text-cyan-300 font-semibold mt-2",
  plus: "text-emerald-300 before:content-['+_'] before:text-emerald-400/70 pl-3",
  bullet: "text-emerald-300 before:content-['-_'] before:text-emerald-400/70 pl-3",
  fixed: "text-sky-300 before:content-['✓_'] before:text-sky-400/80 pl-3",
  pending: "text-amber-300 before:content-['•_'] before:text-amber-400/70 pl-3",
  blank: "block h-3",
};
---

<section class="section-plain">
  <div class="site-container changelog-layout">
    <div class="section-heading">
      <h2>{copy.updates.title}</h2>
      <p>{copy.updates.description}</p>
      <div class="changelog-meta"><strong>{liveLabel}</strong><span>2026 · 3.0.3</span></div>
    </div>
    <div class="changelog-window">
      <div class="flex items-center gap-2 border-b border-white/10 bg-[#111821] px-4 py-2.5">
      <div class="flex gap-1.5">
        <span class="size-3 rounded-full bg-red-500/70"></span>
        <span class="size-3 rounded-full bg-amber-500/70"></span>
        <span class="size-3 rounded-full bg-emerald-500/70"></span>
      </div>
      <span class="ml-2 font-mono text-xs text-slate-400">arepatool@3.0.3 ~ {changelogFile}</span>
      <span class="ml-auto text-[0.62rem] font-bold tracking-[0.1em] text-[#a27a23] uppercase">
        {copy.updates.current}
      </span>
      </div>
      <pre class="max-h-[28rem] overflow-y-auto bg-[#0b1016] p-6 font-mono text-[0.82rem] leading-relaxed text-slate-200 whitespace-pre-wrap">{
      changelog.map((line) =>
        line.type === "blank" ? (
          <span class={lineClass.blank} />
        ) : (
          <span class={`block ${lineClass[line.type]}`}>{line.text}</span>
        ),
      )
      }</pre>
    </div>
  </div>
</section>

<style>
  .changelog-window {
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 13%);
    border-radius: .65rem;
    background: #0b1016;
    box-shadow: 0 22px 50px rgb(0 0 0 / 28%);
  }

  .changelog-window pre {
    margin: 0;
  }
</style>
