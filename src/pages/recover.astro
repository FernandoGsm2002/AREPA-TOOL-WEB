---
import Layout from "@/layouts/Layout.astro";
import RecoverForm from "@/components/auth/RecoverForm";
import AuthShell from "@/components/auth/AuthShell.astro";
---

<Layout title="Recuperar Contraseña - ArepaTool" description="Recupera el acceso a tu cuenta ArepaTool.">
  <AuthShell title="Recuperar Acceso" description="Ingresa tu email para recibir un link de reseteo">
    <RecoverForm client:load />
    <p slot="footer"><a href="/" class="auth-back">← Volver al Inicio</a></p>
  </AuthShell>
</Layout>
