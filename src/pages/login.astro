---
import Layout from "@/layouts/Layout.astro";
import LoginForm from "@/components/dashboard/LoginForm";
import AuthShell from "@/components/auth/AuthShell.astro";
---

<Layout title="Iniciar sesión - ArepaTool" description="Accede a tu cuenta de ArepaTool: crea DNS, revisa tu historial y tu licencia.">
  <AuthShell title="Iniciar sesión" description="Crea DNS, revisa tu historial y tu licencia">
    <LoginForm client:load />
    <p slot="footer"><a href="/" class="auth-back">← Volver al inicio</a></p>
  </AuthShell>
</Layout>
