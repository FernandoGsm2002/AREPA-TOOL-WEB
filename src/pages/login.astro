---
import Layout from "@/layouts/Layout.astro";
import LoginForm from "@/components/dashboard/LoginForm";
---

<Layout title="Iniciar sesión - ArepaTool" description="Accede a tu cuenta de ArepaTool: crea DNS, revisa tu historial y tu licencia.">
  <div class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-10">
    <div class="bg-primary/15 pointer-events-none absolute -top-40 -right-40 size-112 rounded-full blur-3xl"></div>
    <div class="bg-sky-500/10 pointer-events-none absolute -bottom-40 -left-40 size-112 rounded-full blur-3xl"></div>
    <div class="border-border/60 bg-card/95 relative w-full max-w-sm rounded-2xl border p-8 shadow-2xl shadow-black/20 backdrop-blur sm:p-9">
      <div class="mb-6 text-center">
        <a href="/" class="mx-auto flex h-20 w-44 items-center overflow-hidden rounded-2xl border border-white/8 bg-white/[0.03] px-2">
          <img src="/pngs/arepalanding.png" alt="ArepaTool" class="-my-9 h-40 w-full object-contain" />
        </a>
        <h1 class="font-display mt-5 text-2xl font-bold tracking-[-0.03em]">Iniciar sesión</h1>
        <p class="text-muted-foreground mt-1 text-sm">Crea DNS, revisa tu historial y tu licencia</p>
      </div>
      <LoginForm client:load />
      <p class="mt-6 text-center">
        <a href="/" class="text-muted-foreground hover:text-foreground text-xs">← Volver al inicio</a>
      </p>
    </div>
  </div>
</Layout>
