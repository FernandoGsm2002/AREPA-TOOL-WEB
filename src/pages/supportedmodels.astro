---
import { faAndroid } from "@fortawesome/free-brands-svg-icons";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { KeyRound, RotateCcw, Search } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/site/Navbar.astro";
import Footer from "@/components/site/Footer.astro";
import WhatsAppModal from "@/components/site/WhatsAppModal";
import TranssionModels from "@/components/site/TranssionModels";
import { androidVersions, supportedCombinations, testModels } from "@/lib/supported-models";

const byAndroid = androidVersions.map((android) => ({ android, models: supportedCombinations.filter((model) => model.android === android) }));
const totalModels = supportedCombinations.length + testModels.length;
---

<Layout title="Modelos soportados | ArepaTool" description="Modelos Motorola, Infinix, Tecno e Itel soportados por ArepaTool.">
  <Navbar />
  <main class="models-page">
    <div class="models-wrap">
      <header class="models-header"><h1>Modelos soportados</h1><span>{totalModels}</span></header>
      <nav class="brand-nav" role="tablist" aria-label="Marcas de modelos soportados">
        <button type="button" class="brand-tab is-active" role="tab" aria-selected="true" aria-controls="motorola" data-catalog-tab="motorola"><span class="brand-mark">M</span>Motorola</button>
        <button type="button" class="brand-tab" role="tab" aria-selected="false" aria-controls="transsion-panel" data-catalog-tab="transsion-panel"><span class="brand-mark transsion-mark">T</span>Infinix · Tecno · Itel</button>
      </nav>

      <section id="motorola" class="brand-stage" aria-label="Modelos Motorola soportados">
        <img src="/pngs/motorola.png" alt="" class="motorola-backdrop" aria-hidden="true" />
        <div class="catalog-controls" role="search">
          <label class="search-field"><Search className="size-4" /><input id="model-search" type="search" placeholder="Buscar modelo o SKU" autocomplete="off" /></label>
          <div class="android-filter" aria-label="Filtrar por Android">
            <button type="button" class="is-selected" data-version="all">Todos</button>
            {androidVersions.map((android) => <button type="button" data-version={android}><FontAwesomeIcon icon={faAndroid} /> Android {android}</button>)}
          </div>
        </div>
        <p id="catalog-status" class="catalog-status" aria-live="polite">{totalModels} modelos visibles</p>

        <div class="android-groups">
          {byAndroid.map(({ android, models }) => (
            <section class="android-group" data-group={android}>
              <div class="android-heading"><span><FontAwesomeIcon icon={faAndroid} /> Android {android}</span><i></i><small>{models.length}</small></div>
              <div class="model-grid">
                {models.map((model) => (
                  <article class="model-card" data-model-card data-android={android} data-search={`${model.sku} ${model.name}`.toLowerCase()}>
                    <span class="model-sku">{model.sku}</span><h2>{model.name}</h2>
                    <div class="model-operations"><span><KeyRound className="size-3.5" /> Unlock BL</span><span><RotateCcw className="size-3.5" /> Android FRP</span></div>
                  </article>
                ))}
              </div>
            </section>
          ))}
          <section class="android-group" data-group="test">
            <div class="android-heading"><span>Modelos para test</span><i></i><small>{testModels.length}</small></div>
            <div class="model-grid">
              {testModels.map((model) => (
                <article class="model-card test-card" data-model-card data-android="test" data-search={`${model.sku} ${model.name} ${model.codename}`.toLowerCase()}>
                  <span class="model-sku">{model.sku}</span><h2>{model.name}</h2>
                  <div class="model-operations"><span><KeyRound className="size-3.5" /> Temp Unlock BL</span><span><RotateCcw className="size-3.5" /> Android FRP</span></div>
                </article>
              ))}
            </div>
          </section>
        </div>
        <div id="catalog-empty" class="catalog-empty" hidden>No encontramos un modelo compatible.</div>
      </section>
      <div id="transsion-panel" role="tabpanel" hidden><TranssionModels client:load /></div>
    </div>
  </main>
  <Footer />
  <WhatsAppModal client:load />
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>("#model-search");
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-version]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-model-card]"));
  const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-group]"));
  const status = document.querySelector<HTMLElement>("#catalog-status");
  const empty = document.querySelector<HTMLElement>("#catalog-empty");
  const catalogTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-catalog-tab]"));
  const catalogPanels = Array.from(document.querySelectorAll<HTMLElement>("#motorola, #transsion-panel"));
  let selectedVersion = "all";
  const render = () => {
    const query = input?.value.trim().toLowerCase() ?? ""; let visible = 0;
    cards.forEach((card) => { const show = (selectedVersion === "all" || card.dataset.android === selectedVersion) && (!query || (card.dataset.search ?? "").includes(query)); card.hidden = !show; if (show) visible += 1; });
    groups.forEach((group) => { group.hidden = !group.querySelector("[data-model-card]:not([hidden])"); });
    if (status) status.textContent = `${visible} ${visible === 1 ? "modelo visible" : "modelos visibles"}`;
    if (empty) empty.hidden = visible !== 0;
  };
  input?.addEventListener("input", render);
  filterButtons.forEach((button) => button.addEventListener("click", () => { selectedVersion = button.dataset.version ?? "all"; filterButtons.forEach((item) => item.classList.toggle("is-selected", item === button)); render(); }));
  catalogTabs.forEach((tab) => tab.addEventListener("click", () => {
    const selected = tab.dataset.catalogTab;
    catalogPanels.forEach((panel) => { panel.hidden = panel.id !== selected; });
    catalogTabs.forEach((item) => {
      const active = item === tab;
      item.classList.toggle("is-active", active);
      item.setAttribute("aria-selected", String(active));
    });
  }));
</script>

<style>
  .models-page { min-height: calc(100vh - 5.5rem); background: #0b101a; }
  .models-wrap { width: min(100% - 2rem, 76rem); margin: 0 auto; padding: 2.8rem 0 5rem; }
  .models-header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .models-header h1 { color: oklch(0.97 0.004 255); font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 700; letter-spacing: -.055em; line-height: 1; }
  .models-header > span { color: oklch(0.62 0.025 255); font: 600 .75rem/1 var(--font-mono); }
  .brand-nav { display: flex; gap: .5rem; margin-top: 2rem; border-bottom: 1px solid oklch(0.76 0.02 255 / 15%); }
  .brand-tab { display: inline-flex; align-items: center; gap: .6rem; border: 0; border-bottom: 2px solid transparent; background: transparent; padding: .7rem .75rem .85rem; color: oklch(0.65 0.02 255); font-size: .88rem; font-weight: 650; }
  .brand-tab.is-active { border-color: #e60000; color: white; }
  .brand-mark { display: grid; width: 1.45rem; height: 1.45rem; place-items: center; border-radius: 999px; background: #e60000; color: white; font: 700 .67rem/1 var(--font-display); }
  .transsion-mark { background: oklch(0.62 0.14 235); }
  .brand-stage { position: relative; isolation: isolate; overflow: hidden; padding-top: 1.35rem; }
  .motorola-backdrop { position: absolute; z-index: -1; top: -13.5rem; right: -17rem; width: 49rem; max-width: none; opacity: .075; pointer-events: none; }
  .catalog-controls { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
  .search-field { display: flex; min-width: min(100%, 18rem); flex: 1 1 19rem; align-items: center; gap: .65rem; border: 1px solid oklch(0.76 0.02 255 / 16%); border-radius: .65rem; background: oklch(0.15 0.017 255 / .8); padding: 0 .85rem; color: oklch(0.62 0.02 255); }
  .search-field:focus-within { border-color: oklch(0.7 0.12 253 / .75); }
  .search-field input { width: 100%; border: 0; background: transparent; padding: .78rem 0; color: white; font-size: .9rem; outline: none; }
  .search-field input::placeholder { color: oklch(0.48 0.018 255); }
  .android-filter { display: flex; flex-wrap: wrap; gap: .35rem; }
  .android-filter button { display: inline-flex; align-items: center; gap: .35rem; border: 1px solid transparent; border-radius: .5rem; padding: .58rem .63rem; color: oklch(0.62 0.02 255); font-size: .76rem; transition: border-color .16s, background .16s, color .16s; }
  .android-filter button:hover { border-color: oklch(0.76 0.02 255 / 19%); color: white; }
  .android-filter button.is-selected { border-color: oklch(0.7 0.12 253 / .48); background: oklch(0.67 0.14 253 / .18); color: oklch(0.88 0.045 253); }
  .catalog-status { margin-top: 1.1rem; color: oklch(0.49 0.018 255); font: 500 .7rem/1 var(--font-mono); }
  .android-groups { margin-top: 2rem; }
  .android-group + .android-group { margin-top: 2.7rem; }
  .android-heading { display: flex; align-items: center; gap: .7rem; margin-bottom: .8rem; }
  .android-heading span { display: inline-flex; align-items: center; gap: .4rem; color: oklch(0.82 0.05 205); font: 600 .82rem/1 var(--font-mono); }
  .android-heading i { height: 1px; flex: 1; background: oklch(0.76 0.02 255 / 14%); }
  .android-heading small { color: oklch(0.45 0.018 255); font: .7rem/1 var(--font-mono); }
  .model-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .65rem; }
  .model-card { min-height: 8.8rem; border: 1px solid oklch(0.76 0.02 255 / 13%); border-radius: .72rem; background: oklch(0.145 0.016 255 / .75); padding: .85rem; transition: border-color .16s, background .16s; }
  .model-card:hover { border-color: oklch(0.71 0.1 205 / .52); background: oklch(0.175 0.021 255 / .9); }
  .model-sku { color: oklch(0.67 0.025 255); font: 600 .69rem/1 var(--font-mono); }
  .model-card h2 { margin-top: .75rem; color: white; font-size: .91rem; font-weight: 650; line-height: 1.32; }
  .model-operations { display: flex; flex-wrap: wrap; gap: .35rem .6rem; margin-top: 1.2rem; color: oklch(0.62 0.035 205); font-size: .68rem; }
  .model-operations span { display: inline-flex; align-items: center; gap: .35rem; }
  .test-card { background: oklch(0.16 0.022 205 / .7); }
  .catalog-empty { margin-top: 2rem; border: 1px dashed oklch(0.76 0.02 255 / 18%); border-radius: .7rem; padding: 1.1rem; color: oklch(0.62 0.02 255); font-size: .88rem; }
  :global(.transsion-stage) { padding-top: 1.35rem; }
  :global(.transsion-header) { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  :global(.transsion-header h2) { color: oklch(0.97 0.004 255); font: 700 1.25rem/1.15 var(--font-display); letter-spacing: -.03em; }
  :global(.transsion-header p) { margin-top: .45rem; color: oklch(0.62 0.02 255); font-size: .88rem; }
  :global(.transsion-count) { color: oklch(0.49 0.018 255); font: 500 .7rem/1 var(--font-mono); }
  :global(.transsion-operations) { display: flex; flex-wrap: wrap; gap: .35rem .75rem; margin-top: 1.4rem; color: oklch(0.62 0.035 205); font-size: .72rem; }
  :global(.transsion-operations span) { display: inline-flex; align-items: center; gap: .35rem; }
  :global(.transsion-filter) { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: 1.5rem; }
  :global(.transsion-filter button) { display: inline-flex; align-items: center; border: 1px solid transparent; border-radius: .5rem; background: transparent; padding: .58rem .63rem; color: oklch(0.62 0.02 255); font-size: .76rem; transition: border-color .16s, background .16s, color .16s; }
  :global(.transsion-filter button:hover) { border-color: oklch(0.76 0.02 255 / 19%); color: white; }
  :global(.transsion-filter button.is-selected) { border-color: oklch(0.7 0.12 253 / .48); background: oklch(0.67 0.14 253 / .18); color: oklch(0.88 0.045 253); }
  :global(.transsion-state) { display: flex; align-items: center; gap: .5rem; margin-top: 1.25rem; border: 1px solid oklch(0.76 0.02 255 / 13%); border-radius: .72rem; background: oklch(0.145 0.016 255 / .75); padding: 1rem; color: oklch(0.62 0.02 255); font-size: .88rem; }
  :global(.transsion-state.is-empty) { border-style: dashed; }
  :global(.transsion-grid) { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .65rem; margin-top: 1.25rem; }
  :global(.transsion-card) { min-height: 8.8rem; border: 1px solid oklch(0.76 0.02 255 / 13%); border-radius: .72rem; background: oklch(0.145 0.016 255 / .75); padding: .85rem; transition: border-color .16s, background .16s; }
  :global(.transsion-card:hover) { border-color: oklch(0.71 0.1 205 / .52); background: oklch(0.175 0.021 255 / .9); }
  :global(.transsion-meta) { display: flex; align-items: flex-start; justify-content: space-between; gap: .6rem; color: oklch(0.67 0.025 255); font: 600 .69rem/1 var(--font-mono); }
  :global(.transsion-brand) { color: oklch(0.62 0.035 205); }
  :global(.transsion-card h3) { margin-top: .75rem; color: white; font-size: .91rem; font-weight: 650; line-height: 1.32; }
  :global(.transsion-card p) { margin-top: .45rem; color: oklch(0.62 0.02 255); font-size: .75rem; line-height: 1.4; }
  @media (max-width: 1023px) { .model-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 1023px) { :global(.transsion-grid) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .models-wrap { width: min(100% - 1.5rem, 76rem); padding-top: 2rem; } .motorola-backdrop { top: -12rem; right: -25rem; opacity: .06; } .model-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; } .model-card { min-height: 9.5rem; padding: .75rem; } .model-card h2 { font-size: .84rem; } .android-filter { width: 100%; } .android-filter button { flex: 1 0 auto; justify-content: center; } :global(.transsion-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; } :global(.transsion-card) { min-height: 9.5rem; padding: .75rem; } :global(.transsion-card h3) { font-size: .84rem; } }
</style>
