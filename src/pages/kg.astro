---
const playProtectIntent = "intent://com.google.android.gsf.login.LoginActivity/#Intent;scheme=android-app;end";
const apiBase = import.meta.env.PUBLIC_ARPKNXGUARD_API_URL || "https://api2.arepatool.com/api/arpknxguard";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070a0d" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>ARPKNXGUARD · ArepaTool</title>
    <link rel="icon" type="image/png" href="/arpknxguard/icon.png" />
    <style>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: 28px 18px;
        overflow-x: hidden;
        color: #f3f7f4;
        background:
          radial-gradient(circle at 50% -10%, rgb(34 197 94 / 14%), transparent 42%),
          radial-gradient(circle at 100% 100%, rgb(34 197 94 / 6%), transparent 34%),
          #070a0d;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: .18;
        background-image: linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px);
        background-size: 42px 42px;
        mask-image: linear-gradient(to bottom, black, transparent 75%);
      }
      main { position: relative; width: min(100%, 440px); }
      .card {
        position: relative;
        overflow: hidden;
        padding: 30px 24px 24px;
        border: 1px solid rgb(255 255 255 / 9%);
        border-radius: 28px;
        background: linear-gradient(155deg, rgb(20 27 29 / 97%), rgb(10 14 17 / 98%));
        box-shadow: 0 28px 80px rgb(0 0 0 / 48%), inset 0 1px 0 rgb(255 255 255 / 4%);
      }
      .card::before {
        content: "";
        position: absolute;
        width: 190px;
        height: 190px;
        top: -110px;
        right: -70px;
        border-radius: 50%;
        background: #22c55e;
        filter: blur(85px);
        opacity: .13;
        pointer-events: none;
      }
      .hero { position: relative; text-align: center; margin-bottom: 28px; }
      .logo-wrap {
        width: 92px;
        height: 92px;
        display: grid;
        place-items: center;
        margin: 0 auto 16px;
        border: 1px solid rgb(74 222 128 / 22%);
        border-radius: 26px;
        background: linear-gradient(145deg, rgb(34 197 94 / 12%), rgb(255 255 255 / 2%));
        box-shadow: 0 12px 35px rgb(0 0 0 / 30%);
      }
      .logo { display: block; width: 78px; height: 78px; object-fit: contain; }
      .eyebrow { display: flex; align-items: center; justify-content: center; gap: 7px; color: #75e69c; font-size: 10px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
      .eyebrow::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 12px #4ade80; }
      h1 { margin: 9px 0 6px; font-size: clamp(25px, 7vw, 31px); line-height: 1.1; letter-spacing: .025em; }
      .subtitle { margin: 0; color: #8d9a94; font-size: 14px; }
      .steps { display: grid; gap: 0; }
      .step { position: relative; display: grid; grid-template-columns: 34px 1fr; column-gap: 13px; padding: 0 0 24px; }
      .step:last-child { padding-bottom: 0; }
      .step:not(:last-child)::after { content: ""; position: absolute; left: 16px; top: 36px; bottom: 2px; width: 1px; background: linear-gradient(#2c3b33, rgb(44 59 51 / 15%)); }
      .number { position: relative; z-index: 1; width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid #31433a; border-radius: 11px; color: #86efac; background: #142019; font-size: 12px; font-weight: 800; }
      .content { min-width: 0; padding-top: 1px; }
      .title-row { min-height: 32px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
      h2 { margin: 0; color: #ecf2ee; font-size: 15px; line-height: 1.35; font-weight: 700; }
      .hint { margin: 5px 0 0; color: #829087; font-size: 12px; line-height: 1.45; }
      .tag { flex: none; padding: 4px 7px; border: 1px solid rgb(255 255 255 / 7%); border-radius: 6px; color: #6f7f75; font-size: 9px; font-weight: 800; letter-spacing: .08em; }
      .button {
        width: 100%;
        min-height: 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        border: 0;
        border-radius: 13px;
        padding: 13px 16px;
        color: #07160d;
        background: linear-gradient(135deg, #4ade80, #22c55e);
        box-shadow: 0 8px 24px rgb(34 197 94 / 14%);
        font: inherit;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
        transition: transform .18s ease, filter .18s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .button:active { transform: scale(.985); }
      .button:disabled { opacity: .58; cursor: wait; }
      .button svg { width: 17px; height: 17px; flex: none; }
      .secondary { margin-top: 12px; border: 1px solid rgb(255 255 255 / 9%); color: #d6dfd9; background: rgb(255 255 255 / 4%); box-shadow: none; }
      .code-form { margin-top: 13px; }
      .input-wrap { position: relative; }
      .input-wrap svg { position: absolute; left: 15px; top: 50%; width: 18px; height: 18px; color: #64746a; transform: translateY(-50%); pointer-events: none; }
      input {
        width: 100%;
        height: 56px;
        border: 1px solid #2d3b33;
        border-radius: 14px;
        outline: none;
        padding: 0 16px 0 44px;
        color: #f0fdf4;
        background: rgb(3 7 5 / 55%);
        caret-color: #4ade80;
        font: 750 23px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
        letter-spacing: .35em;
        text-align: center;
        transition: border-color .18s, box-shadow .18s;
      }
      input::placeholder { color: #405047; }
      input:focus { border-color: #34d374; box-shadow: 0 0 0 3px rgb(52 211 116 / 10%); }
      .code-form .button { margin-top: 10px; }
      .status { min-height: 0; margin: 0; color: #9eaaa2; font-size: 12px; line-height: 1.45; }
      .status:not(:empty) { margin-top: 10px; }
      .error { color: #fda4a4; }
      .success { color: #86efac; }
      .download-section { margin-top: 12px; }
      .download-section .button { animation: reveal .25s ease-out; }
      .download-expiry { margin: 8px 0 0; color: #718078; font-size: 11px; text-align: center; }
      .run-label { display: inline-flex; align-items: center; gap: 7px; margin-top: 11px; padding: 8px 11px; border: 1px solid rgb(74 222 128 / 12%); border-radius: 9px; color: #a6b4aa; background: rgb(74 222 128 / 4%); font-size: 11px; font-weight: 650; }
      .run-label svg { width: 13px; height: 13px; color: #4ade80; }
      .footer { display: flex; align-items: center; justify-content: center; gap: 7px; margin: 20px 0 0; color: #59685f; font-size: 11px; text-align: center; }
      .footer svg { width: 13px; height: 13px; flex: none; }
      [hidden] { display: none !important; }
      @keyframes reveal { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
      @media (max-width: 380px) { .card { padding: 25px 19px 21px; border-radius: 24px; } .logo-wrap { width: 82px; height: 82px; } .logo { width: 70px; height: 70px; } }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
    </style>
  </head>
  <body>
    <main data-api-base={apiBase}>
      <section class="card" aria-labelledby="page-title">
        <header class="hero">
          <div class="logo-wrap"><img class="logo" src="/arpknxguard/icon.png" alt="ARPKNXGUARD" width="256" height="256" /></div>
          <div class="eyebrow">ArepaTool · Samsung</div>
          <h1 id="page-title">ARPKNXGUARD</h1>
          <p class="subtitle">Completa tres pasos para comenzar.</p>
        </header>

        <div class="steps">
          <section class="step" aria-labelledby="protect-title">
            <div class="number">01</div>
            <div class="content">
              <div class="title-row"><h2 id="protect-title">Desactiva Play Protect</h2><span class="tag">PLAY STORE</span></div>
              <p class="hint">Desactívalo en Play Store y vuelve aquí.</p>
              <a class="button secondary" href={playProtectIntent}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 4.5 6v5.2c0 4.6 3.1 8.2 7.5 9.8 4.4-1.6 7.5-5.2 7.5-9.8V6L12 3Z"/><path d="m9 12 2 2 4-4"/></svg>
                Abrir Play Protect
              </a>
            </div>
          </section>

          <section class="step" aria-labelledby="download-title">
            <div class="number">02</div>
            <div class="content">
              <div class="title-row"><h2 id="download-title">Descarga la aplicación</h2><span class="tag">APK</span></div>
              <p class="hint">Ingresa tu código de seis caracteres (letras y números).</p>
              <form class="code-form" id="authorize-form">
                <div class="input-wrap">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="8" cy="15" r="4"/><path d="m10.8 12.2 8-8M15 7l2 2M18 4l2 2"/></svg>
                  <input id="ticket-code" name="code" type="text" inputmode="text" pattern="[A-Za-z][0-9][A-Za-z][0-9][A-Za-z][0-9]" maxlength="6" autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" enterkeyhint="done" required placeholder="A1B2C3" aria-label="Código de seis caracteres" aria-describedby="status" style="text-transform: uppercase;" />
                </div>
                <button class="button" id="authorize-button" type="submit">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 17v3h14v-3"/></svg>
                  <span>Validar y descargar</span>
                </button>
              </form>
              <p id="status" class="status" role="status" aria-live="polite"></p>
              <div class="download-section" id="download-section" hidden>
                <a class="button" id="download-link" href="#" download="ARPKNXGUARD.apk">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 17v3h14v-3"/></svg>
                  Descargar ARPKNXGUARD
                </a>
                <p class="download-expiry" id="download-expiry"></p>
              </div>
            </div>
          </section>

          <section class="step" aria-labelledby="run-title">
            <div class="number">03</div>
            <div class="content">
              <div class="title-row"><h2 id="run-title">Instala y ejecuta</h2><span class="tag">LISTO</span></div>
              <p class="hint">Abre la APK, ingresa el mismo código y pulsa:</p>
              <div class="run-label">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z"/></svg>
                Run ArpKnxGuard Exploit
              </div>
            </div>
          </section>
        </div>
      </section>
      <p class="footer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 8.8a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0"/><circle cx="12" cy="19" r="1" fill="currentColor" stroke="none"/></svg>
        Mantén el teléfono conectado a Wi-Fi
      </p>
    </main>

    <script>
      const main = document.querySelector("main");
      const form = document.getElementById("authorize-form");
      const input = document.getElementById("ticket-code");
      const button = document.getElementById("authorize-button");
      const buttonLabel = button.querySelector("span");
      const status = document.getElementById("status");
      const downloadSection = document.getElementById("download-section");
      const downloadLink = document.getElementById("download-link");
      const downloadExpiry = document.getElementById("download-expiry");
      const apiBase = main.dataset.apiBase.replace(/\/$/, "");
      const apiOrigin = new URL(apiBase).origin;
      const messages = {
        CODE_INVALID: "El código no es válido. Revísalo e inténtalo de nuevo.",
        CODE_EXPIRED: "El código expiró. Genera uno nuevo en ArepaTool.",
        CODE_ALREADY_USED: "Este código ya fue utilizado.",
        CODE_REVOKED: "Este código fue revocado. Solicita uno nuevo.",
        DOWNLOAD_EXPIRED: "El enlace expiró. Vuelve a validar el código."
      };

      input.addEventListener("input", () => {
        input.value = input.value.toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 6);
        status.textContent = "";
        status.className = "status";
        downloadSection.hidden = true;
        downloadLink.removeAttribute("href");
      });

      form.addEventListener("submit", async event => {
        event.preventDefault();
        const code = input.value;
        if (!/^[A-Z][0-9][A-Z][0-9][A-Z][0-9]$/.test(code)) {
          status.textContent = messages.CODE_INVALID;
          status.className = "status error";
          input.focus();
          return;
        }
        button.disabled = true;
        buttonLabel.textContent = "Validando…";
        downloadSection.hidden = true;
        downloadLink.removeAttribute("href");
        status.textContent = "Comprobando tu código…";
        status.className = "status";
        try {
          const response = await fetch(`${apiBase}/download-authorize`, {
            method: "POST",
            headers: { "Content-Type": "application/json", "Accept": "application/json" },
            body: JSON.stringify({ code }),
            cache: "no-store",
            credentials: "omit",
            referrerPolicy: "no-referrer"
          });
          const result = await response.json().catch(() => null);
          if (!response.ok || result?.success !== true) {
            const error = new Error(result?.error || `HTTP_${response.status}`);
            error.userMessage = messages[error.message] || "No se pudo autorizar la descarga. Inténtalo nuevamente.";
            throw error;
          }
          if (typeof result.downloadPath !== "string" || !/^\/api\/arpknxguard\/download\/[A-Za-z0-9_-]{43}$/.test(result.downloadPath)
            || !Number.isFinite(result.expiresAt)) {
            throw new Error("INVALID_RESPONSE");
          }
          const downloadUrl = new URL(result.downloadPath, apiOrigin);
          if (downloadUrl.origin !== apiOrigin) throw new Error("INVALID_RESPONSE");
          downloadLink.href = downloadUrl.href;
          downloadExpiry.textContent = `Disponible hasta las ${new Date(result.expiresAt).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}`;
          downloadSection.hidden = false;
          status.textContent = "Código verificado. Tu descarga está lista.";
          status.className = "status success";
        } catch (error) {
          status.textContent = error.userMessage || "No hay conexión con el servidor. Revisa Internet e inténtalo de nuevo.";
          status.className = "status error";
        } finally {
          button.disabled = false;
          buttonLabel.textContent = "Validar y descargar";
        }
      });
    </script>
  </body>
</html>
