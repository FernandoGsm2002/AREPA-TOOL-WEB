---
import Layout from "@/layouts/Layout.astro";
import RegisterForm from "@/components/auth/RegisterForm";
---

<Layout title="Registro - ArepaTool" description="Crea una cuenta de ArepaTool.">
  <main class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-10">
    <div class="bg-primary/15 pointer-events-none absolute -top-40 -right-40 size-112 rounded-full blur-3xl"></div>
    <div class="bg-sky-500/10 pointer-events-none absolute -bottom-40 -left-40 size-112 rounded-full blur-3xl"></div>
    <section class="border-border/60 bg-card/95 relative w-full max-w-sm rounded-2xl border p-8 shadow-2xl shadow-black/20 backdrop-blur sm:p-9">
      <div class="mb-6 text-center">
        <a href="/" class="mx-auto flex h-20 w-44 items-center overflow-hidden rounded-2xl border border-white/8 bg-white/[0.03] px-2"><img src="/pngs/arepalanding.png" alt="ArepaTool" class="-my-9 h-40 w-full object-contain" /></a>
        <h1 class="font-display mt-5 text-2xl font-bold tracking-[-0.03em]">Crear Cuenta</h1>
        <p class="text-muted-foreground mt-1 text-sm">Únete a la comunidad de ArepaTool</p>
      </div>
      <RegisterForm client:load />
      <p class="text-muted-foreground mt-5 border-border/60 border-t pt-5 text-center text-sm">¿Olvidaste tu contraseña? <a href="/recover" class="text-primary font-semibold hover:underline">Recupérala aquí</a></p>
      <p class="mt-6 text-center"><a href="/" class="text-muted-foreground hover:text-foreground text-xs">← Volver al Inicio</a></p>
    </section>
  </main>
</Layout>
