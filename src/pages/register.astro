---
import Layout from "@/layouts/Layout.astro";
import RegisterForm from "@/components/auth/RegisterForm";
import AuthShell from "@/components/auth/AuthShell.astro";
---

<Layout title="Registro - ArepaTool" description="Crea una cuenta de ArepaTool.">
  <AuthShell title="Crear Cuenta" description="Únete a la comunidad de ArepaTool">
    <RegisterForm client:load />
    <div slot="footer">
      <p class="auth-footer-note">¿Olvidaste tu contraseña? <a href="/recover">Recupérala aquí</a></p>
      <p><a href="/" class="auth-back">← Volver al Inicio</a></p>
    </div>
  </AuthShell>
</Layout>
