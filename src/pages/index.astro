---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/site/Navbar.astro";
import AnnouncementBanner from "@/components/site/AnnouncementBanner.astro";
import Hero from "@/components/site/Hero.astro";
import Changelog from "@/components/site/Changelog.astro";
import Features from "@/components/site/Features.astro";
import Tutorials from "@/components/site/Tutorials.astro";
import Pricing from "@/components/site/Pricing.astro";
import Resellers from "@/components/site/Resellers.astro";
import Footer from "@/components/site/Footer.astro";
import WhatsAppModal from "@/components/site/WhatsAppModal";
import InstallerAccessModal from "@/components/site/InstallerAccessModal";
---

<Layout
  title="ArepaTool v2.2.2 - Professional Unlock & MDM Tool"
  description="ArepaTool v2.2.2 adds MTK ROM Patch support for Infinix, Tecno and Itel devices."
>
  <Navbar />
  <main class="landing-shell">
    <AnnouncementBanner />
    <Hero />
    <Changelog />
    <Features />
    <Tutorials />
    <Pricing />
    <Resellers />
  </main>
  <Footer />
  <WhatsAppModal client:load />
  <InstallerAccessModal client:load />
</Layout>
